<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Liveolator.App.Controls">

  <!-- ============================================================
       Performance design line — deep navy, one blue accent, rounded
       panels, rotary knobs + dB faders. Color/brush tokens live in
       App.axaml (Application.Resources).
       ============================================================ -->

  <!-- rotary knob + linear fader default brushes (themed from the tokens) -->
  <Style Selector="controls|Knob">
    <Setter Property="ArcBrush" Value="{StaticResource Accent}" />
    <Setter Property="TrackBrush" Value="{StaticResource S4}" />
    <Setter Property="CapBrush" Value="{StaticResource S2}" />
    <Setter Property="PointerBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="controls|Knob:disabled">
    <Setter Property="ArcBrush" Value="{StaticResource S4}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="controls|Fader">
    <Setter Property="FillBrush" Value="{StaticResource Accent}" />
    <Setter Property="TrackBrush" Value="{StaticResource S4}" />
    <Setter Property="ThumbBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="controls|Fader:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- dB / range tick label beside faders and under knobs -->
  <Style Selector="TextBlock.tick">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="FontFamily" Value="Consolas, 'JetBrains Mono', monospace" />
    <Setter Property="FontSize" Value="9" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- section header (mirrors the mockup's small uppercase title) -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, 'JetBrains Mono', monospace" />
  </Style>

  <!-- reusable panel surface — subtle top-down gradient + rounded corners -->
  <Style Selector="Border.panel">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#161C28" Offset="0" />
        <GradientStop Color="#0F141D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <!-- small round icon button (e.g. the deck "..." menu) -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{StaticResource S3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ============ tab strip (ListBox.tabs) ============ -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.tabs TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2"
                Padding="16,10,16,12">
          <!-- forward ContentTemplate so the ListBox.ItemTemplate (the tab Title) is used,
               not the global ViewLocator (which would look for a non-existent TabItemView) -->
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ row list (ListBox.rows) ============ -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2,0,0,0">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="9,7" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ buttons ============ -->
  <Style Selector="Button.spartan">
    <Setter Property="Background" Value="{StaticResource S3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.spartan:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="BorderBrush" Value="{StaticResource Faint}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ============ text input ============ -->
  <Style Selector="TextBox.spartan">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <!-- ============ progress / phase bars ============ -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- ============ key (beat keys / transport / hot-cues) ============ -->
  <Style Selector="Button.key">
    <Setter Property="Background" Value="{StaticResource S3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.key:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <!-- active toggle: the single accent carries the on-state (paired with text, never color-only) -->
  <Style Selector="Button.key.on">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.key:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- play button: holds a blue triangle; "on" (playing) accents the border instead of filling -->
  <Style Selector="Button.play">
    <Setter Property="Background" Value="{StaticResource S3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S4}" />
  </Style>
  <Style Selector="Button.play.on">
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ scene pad (8×8 grid cell) ============ -->
  <Style Selector="Button.pad">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <!-- loaded cell (has a scene) -->
  <Style Selector="Button.pad.has">
    <Setter Property="Background" Value="{StaticResource S2}" />
  </Style>
  <!-- active scene -->
  <Style Selector="Button.pad.on">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.pad:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

</Styles>
