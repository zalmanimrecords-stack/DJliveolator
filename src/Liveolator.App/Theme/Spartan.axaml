<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Spartan design line — near-monochrome, one accent, hairlines.
       Color/brush tokens live in App.axaml (Application.Resources).
       ============================================================ -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- section header (mirrors the mockup's small uppercase title) -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, 'JetBrains Mono', monospace" />
  </Style>

  <!-- reusable panel surface -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource S1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <!-- ============ tab strip (ListBox.tabs) ============ -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.tabs TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2"
                Padding="16,10,16,12">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ row list (ListBox.rows) ============ -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2,0,0,0">
          <ContentPresenter Content="{TemplateBinding Content}"
                            Padding="9,7" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ buttons ============ -->
  <Style Selector="Button.spartan">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="Button.spartan:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource S3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Faint}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ============ text input ============ -->
  <Style Selector="TextBox.spartan">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

</Styles>
