<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Liveolator.App.Controls">

  <Styles.Resources>
    <!-- A separate stationary well under the moving face makes a press read as travel,
         rather than as a flat color change. -->
    <ControlTemplate x:Key="HardwareButtonTemplate" TargetType="Button">
      <Grid>
        <Border Name="PART_Well"
                Margin="0,4,0,0"
                Background="#070A0F"
                BorderBrush="#263243"
                BorderThickness="1"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="inset 0 2 4 0 #B3000000" />
        <ContentPresenter Name="PART_Face"
                          Margin="0,0,0,4"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}"
                          TextElement.Foreground="{TemplateBinding Foreground}" />
      </Grid>
    </ControlTemplate>
  </Styles.Resources>

  <!-- ============================================================
       Performance design line — deep navy, one blue accent, rounded
       panels, rotary knobs + dB faders. Color/brush tokens live in
       App.axaml (Application.Resources).
       ============================================================ -->

  <!-- rotary knob + linear fader default brushes (themed from the tokens) -->
  <Style Selector="controls|Knob">
    <Setter Property="ArcBrush" Value="{StaticResource Accent}" />
    <Setter Property="TrackBrush" Value="{StaticResource S4}" />
    <Setter Property="CapBrush" Value="{StaticResource S2}" />
    <Setter Property="PointerBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="controls|Knob:disabled">
    <Setter Property="ArcBrush" Value="{StaticResource S4}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <Style Selector="controls|Fader">
    <Setter Property="FillBrush" Value="{StaticResource Accent}" />
    <Setter Property="TrackBrush" Value="{StaticResource S4}" />
    <Setter Property="ThumbBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="controls|Fader:disabled">
    <Setter Property="Opacity" Value="0.6" />
  </Style>

  <!-- dB / range tick label beside faders and under knobs (Dim, not Faint — legible at 9px) -->
  <Style Selector="TextBlock.tick">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="FontFamily" Value="Consolas, 'JetBrains Mono', monospace" />
    <Setter Property="FontSize" Value="9" />
  </Style>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- section header (mirrors the mockup's small uppercase title) -->
  <Style Selector="TextBlock.section">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, 'JetBrains Mono', monospace" />
  </Style>

  <!-- reusable panel surface — subtle top-down gradient + rounded corners -->
  <Style Selector="Border.panel">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#161C28" Offset="0" />
        <GradientStop Color="#0F141D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>

  <!-- small round icon button (e.g. the deck "..." menu) -->
  <Style Selector="Button.icon">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource S4Color}" Offset="0" />
        <GradientStop Color="{StaticResource S3Color}" Offset="0.48" />
        <GradientStop Color="#111722" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.icon /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 3 0 #80000000, inset 0 1 0 0 #38FFFFFF, inset 0 -2 3 0 #52000000" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#354154" Offset="0" />
        <GradientStop Color="{StaticResource S4Color}" Offset="0.55" />
        <GradientStop Color="#19212D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="BoxShadow" Value="0 1 1 0 #66000000, inset 0 2 4 0 #99000000" />
  </Style>

  <!-- ============ tab strip (ListBox.tabs) ============ -->
  <Style Selector="ListBox.tabs">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBox.tabs TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="1.6" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Faint}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0,0,0,2"
                Padding="16,10,16,12">
          <!-- forward ContentTemplate so the ListBox.ItemTemplate (the tab Title) is used,
               not the global ViewLocator (which would look for a non-existent TabItemView) -->
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:pointerover">
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected">
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="ListBox.tabs ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ row list (ListBox.rows) ============ -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Bd"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="2,0,0,0">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="9,7" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ Border#PART_Bd">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>

  <!-- ============ buttons ============ -->
  <Style Selector="Button.spartan">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="{StaticResource S4Color}" Offset="0" />
        <GradientStop Color="{StaticResource S3Color}" Offset="0.46" />
        <GradientStop Color="#111722" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.spartan /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 3 0 #80000000, inset 0 1 0 0 #38FFFFFF, inset 0 -2 3 0 #52000000" />
  </Style>
  <Style Selector="Button.spartan:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#354154" Offset="0" />
        <GradientStop Color="{StaticResource S4Color}" Offset="0.55" />
        <GradientStop Color="#19212D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Faint}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.spartan:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BoxShadow" Value="0 1 1 0 #66000000, inset 0 2 4 0 #99000000" />
  </Style>
  <Style Selector="Button.accent">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#69A7FF" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.42" />
        <GradientStop Color="#1E5EC5" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderBrush" Value="#70FFFFFF" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.accent /template/ Border#PART_Well">
    <Setter Property="Background" Value="#10294E" />
    <Setter Property="BorderBrush" Value="#1B559F" />
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 5 0 #802F80F6, inset 0 1 0 0 #8CFFFFFF, inset 0 -3 4 0 #4D0B3475" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#82B6FF" Offset="0" />
        <GradientStop Color="#3E8BFA" Offset="0.42" />
        <GradientStop Color="#2468D3" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BoxShadow" Value="0 3 8 0 #992F80F6, inset 0 1 0 0 #A6FFFFFF, inset 0 -3 4 0 #4D0B3475" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="BoxShadow" Value="0 1 3 0 #662F80F6, inset 0 3 5 0 #66123664" />
  </Style>

  <!-- ============ text input ============ -->
  <Style Selector="TextBox.spartan">
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>

  <!-- ============ progress / phase bars ============ -->
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- ============ key (beat keys / transport / hot-cues) ============ -->
  <Style Selector="Button.key">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#303B4D" Offset="0" />
        <GradientStop Color="{StaticResource S3Color}" Offset="0.42" />
        <GradientStop Color="#101620" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{StaticResource Dim}" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.key /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 4 0 #80000000, inset 0 1 0 0 #47FFFFFF, inset 0 -3 4 0 #66000000" />
  </Style>
  <Style Selector="Button.key:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#3D4B60" Offset="0" />
        <GradientStop Color="{StaticResource S4Color}" Offset="0.48" />
        <GradientStop Color="#18212D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Faint}" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.key:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BoxShadow" Value="0 1 1 0 #66000000, inset 0 3 5 0 #A6000000" />
  </Style>
  <!-- active toggle: the single accent carries the on-state (paired with text, never color-only) -->
  <Style Selector="Button.key.on">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#64A4FF" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.4" />
        <GradientStop Color="#1D5DBF" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.key.on /template/ Border#PART_Well">
    <Setter Property="Background" Value="#10294E" />
    <Setter Property="BorderBrush" Value="#1B559F" />
  </Style>
  <Style Selector="Button.key.on /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 2px)" />
    <Setter Property="BoxShadow" Value="0 1 5 0 #992F80F6, inset 0 1 0 0 #70FFFFFF, inset 0 2 5 0 #52123664" />
  </Style>
  <Style Selector="Button.key.on:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#78AFFF" Offset="0" />
        <GradientStop Color="#3988F8" Offset="0.4" />
        <GradientStop Color="#2265CC" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="TextElement.Foreground" Value="{StaticResource AccentInk}" />
  </Style>
  <Style Selector="Button.key.on:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="BoxShadow" Value="0 0 3 0 #662F80F6, inset 0 3 6 0 #73123664" />
  </Style>
  <Style Selector="Button.key:disabled">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- play button: holds a blue triangle; "on" (playing) accents the border instead of filling -->
  <Style Selector="Button.play">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#303B4D" Offset="0" />
        <GradientStop Color="{StaticResource S3Color}" Offset="0.42" />
        <GradientStop Color="#101620" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,9" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.play /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 4 0 #80000000, inset 0 1 0 0 #47FFFFFF, inset 0 -3 4 0 #66000000" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#3D4B60" Offset="0" />
        <GradientStop Color="{StaticResource S4Color}" Offset="0.48" />
        <GradientStop Color="#18212D" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.play:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 3px)" />
    <Setter Property="Background" Value="{StaticResource S2}" />
    <Setter Property="BoxShadow" Value="0 1 1 0 #66000000, inset 0 3 5 0 #A6000000" />
  </Style>
  <Style Selector="Button.play.on">
    <Setter Property="Background" Value="{StaticResource S4}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.play.on /template/ Border#PART_Well">
    <Setter Property="Background" Value="#10294E" />
    <Setter Property="BorderBrush" Value="#1B559F" />
  </Style>
  <Style Selector="Button.play.on /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    <Setter Property="BoxShadow" Value="0 1 5 0 #802F80F6, inset 0 1 0 0 #47FFFFFF, inset 0 2 5 0 #66000000" />
  </Style>

  <!-- ============ scene pad (8×8 grid cell) ============ -->
  <Style Selector="Button.pad">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#202936" Offset="0" />
        <GradientStop Color="{StaticResource S2Color}" Offset="0.5" />
        <GradientStop Color="#070A0F" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Hair}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Height" Value="22" />
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template" Value="{StaticResource HardwareButtonTemplate}" />
  </Style>
  <Style Selector="Button.pad /template/ ContentPresenter#PART_Face">
    <Setter Property="BoxShadow" Value="0 2 3 0 #80000000, inset 0 1 0 0 #3DFFFFFF, inset 0 -2 3 0 #73000000" />
  </Style>
  <Style Selector="Button.pad:pointerover /template/ ContentPresenter#PART_Face">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#354154" Offset="0" />
        <GradientStop Color="{StaticResource S3Color}" Offset="0.5" />
        <GradientStop Color="#101620" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Faint}" />
  </Style>
  <Style Selector="Button.pad:pressed /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 2px)" />
    <Setter Property="BoxShadow" Value="0 1 1 0 #66000000, inset 0 2 4 0 #A6000000" />
  </Style>
  <!-- loaded cell (has a scene) -->
  <Style Selector="Button.pad.has">
    <Setter Property="Background" Value="{StaticResource S2}" />
  </Style>
  <!-- active scene -->
  <Style Selector="Button.pad.on">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#72AEFF" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="0.45" />
        <GradientStop Color="#1C58B6" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.pad.on /template/ Border#PART_Well">
    <Setter Property="Background" Value="#10294E" />
    <Setter Property="BorderBrush" Value="#1B559F" />
  </Style>
  <Style Selector="Button.pad.on /template/ ContentPresenter#PART_Face">
    <Setter Property="RenderTransform" Value="translate(0px, 1px)" />
    <Setter Property="BoxShadow" Value="0 1 6 0 #A62F80F6, inset 0 1 0 0 #80FFFFFF, inset 0 2 5 0 #52123664" />
  </Style>
  <Style Selector="Button.pad:disabled">
    <Setter Property="Opacity" Value="0.5" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Keep keyboard focus visible without flattening the hardware shadows. -->
  <Style Selector="Button.spartan:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.accent:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.key:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.play:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.pad:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource Text}" />
  </Style>

</Styles>
