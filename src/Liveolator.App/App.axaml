<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Liveolator.App"
             x:Class="Liveolator.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <!-- Design tokens — single blue performance line (the reference DJ deck the user supplied):
         deep navy chrome, ONE blue accent for all active/signal state, one reserved red for
         destructive (blackout/strobe). The former multi-signal keys (Green/Amber/Violet) are kept so
         existing views still resolve, but unified to the blue accent so the whole app reads as one line. -->
    <Color x:Key="BgColor">#0A0D13</Color>
    <Color x:Key="S1Color">#141A26</Color>   <!-- module surface -->
    <Color x:Key="S2Color">#0C1017</Color>   <!-- inset / well (waveform, meters) -->
    <Color x:Key="S3Color">#1A2130</Color>   <!-- control well -->
    <Color x:Key="S4Color">#26303F</Color>   <!-- control hover / knob track -->
    <Color x:Key="HairColor">#232B38</Color> <!-- hairline border -->
    <Color x:Key="TextColor">#E7ECF3</Color>
    <Color x:Key="DimColor">#8B95A7</Color>
    <Color x:Key="FaintColor">#5A6573</Color>
    <Color x:Key="AccentColor">#2F80F6</Color>   <!-- the one accent — active / signal (blue) -->
    <Color x:Key="AccentLightColor">#69A7FF</Color>
    <Color x:Key="AccentDarkColor">#1E5EC5</Color>
    <Color x:Key="AccentWellColor">#10294E</Color>
    <Color x:Key="AccentInkColor">#FFFFFF</Color>
    <Color x:Key="RedColor">#E5544A</Color>      <!-- the one reserved — blackout / strobe -->
    <Color x:Key="GreenColor">#2F80F6</Color>    <!-- unified to the blue accent -->
    <Color x:Key="AmberColor">#2F80F6</Color>    <!-- unified to the blue accent -->
    <Color x:Key="VioletColor">#2F80F6</Color>   <!-- unified to the blue accent -->
    <!-- Deliberate exception to the single-blue line: a true green reserved for live MIDI activity
         (the top-bar signal LED), so an incoming controller signal reads at a glance. -->
    <Color x:Key="MidiActiveColor">#29C467</Color>
    <!-- Deck waveform (a deliberate exception to the single-blue line, for beat-align readability): the
         body is a warm yellow and the kick (low-frequency, ≤150 Hz) band a vivid green glow drawn over it,
         so the kick transients pop in green against the yellow body and a DJ can align downbeats by eye. -->
    <Color x:Key="WaveformColor">#F0C23C</Color>
    <Color x:Key="KickColor">#27C56A</Color>

    <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}" />
    <SolidColorBrush x:Key="S1" Color="{DynamicResource S1Color}" />
    <SolidColorBrush x:Key="S2" Color="{DynamicResource S2Color}" />
    <SolidColorBrush x:Key="S3" Color="{DynamicResource S3Color}" />
    <SolidColorBrush x:Key="S4" Color="{DynamicResource S4Color}" />
    <SolidColorBrush x:Key="Hair" Color="{DynamicResource HairColor}" />
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}" />
    <SolidColorBrush x:Key="Dim" Color="{DynamicResource DimColor}" />
    <SolidColorBrush x:Key="Faint" Color="{DynamicResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentInk" Color="{DynamicResource AccentInkColor}" />
    <SolidColorBrush x:Key="Red" Color="{DynamicResource RedColor}" />
    <SolidColorBrush x:Key="Green" Color="{DynamicResource GreenColor}" />
    <SolidColorBrush x:Key="Amber" Color="{DynamicResource AmberColor}" />
    <SolidColorBrush x:Key="Violet" Color="{DynamicResource VioletColor}" />
    <SolidColorBrush x:Key="MidiActive" Color="{DynamicResource MidiActiveColor}" />
    <SolidColorBrush x:Key="Kick" Color="{DynamicResource KickColor}" />
    <!-- Waveform body: opaque for the played portion, half-transparent for the part still ahead of the playhead. -->
    <SolidColorBrush x:Key="Waveform" Color="{DynamicResource WaveformColor}" />
    <SolidColorBrush x:Key="WaveformAhead" Color="{DynamicResource WaveformColor}" Opacity="0.5" />

    <!-- Retint Fluent's accent so standard controls (combobox, scrollbar, selection, etc.) follow the blue line. -->
    <Color x:Key="SystemAccentColor">#2F80F6</Color>
    <Color x:Key="SystemAccentColorDark1">#2A73DD</Color>
    <Color x:Key="SystemAccentColorDark2">#2563C0</Color>
    <Color x:Key="SystemAccentColorDark3">#1E4F9C</Color>
    <Color x:Key="SystemAccentColorLight1">#5598F8</Color>
    <Color x:Key="SystemAccentColorLight2">#80B2FA</Color>
    <Color x:Key="SystemAccentColorLight3">#ABCCFC</Color>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Liveolator.App/Theme/Spartan.axaml" />
  </Application.Styles>

</Application>
