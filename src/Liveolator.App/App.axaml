<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Liveolator.App"
             x:Class="Liveolator.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <!-- Design tokens — blue / deep-navy performance line (rotary knobs, dB faders, one blue accent) -->
    <Color x:Key="BgColor">#0A0D13</Color>
    <Color x:Key="S1Color">#121723</Color>   <!-- module surface -->
    <Color x:Key="S2Color">#0C1017</Color>   <!-- inset / well (waveform, meters) -->
    <Color x:Key="S3Color">#1A2130</Color>   <!-- control -->
    <Color x:Key="S4Color">#26303F</Color>   <!-- control hover / knob track -->
    <Color x:Key="HairColor">#232B38</Color> <!-- the single border color -->
    <Color x:Key="TextColor">#E7ECF3</Color>
    <Color x:Key="DimColor">#8B95A7</Color>
    <Color x:Key="FaintColor">#5A6573</Color>
    <Color x:Key="AccentColor">#2F80F6</Color>   <!-- the one accent — active / signal -->
    <Color x:Key="AccentInkColor">#FFFFFF</Color>
    <Color x:Key="RedColor">#E5544A</Color>

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="S1" Color="{StaticResource S1Color}" />
    <SolidColorBrush x:Key="S2" Color="{StaticResource S2Color}" />
    <SolidColorBrush x:Key="S3" Color="{StaticResource S3Color}" />
    <SolidColorBrush x:Key="S4" Color="{StaticResource S4Color}" />
    <SolidColorBrush x:Key="Hair" Color="{StaticResource HairColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Liveolator.App/Theme/Spartan.axaml" />
  </Application.Styles>

</Application>
