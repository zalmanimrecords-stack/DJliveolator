<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Liveolator.App"
             x:Class="Liveolator.App.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <!-- Design tokens — canonical "analog-rack" navy line (design/mockups/live-mode.html).
         Multi-signal accents: cyan = beat/active, green = play/locked, amber = cue, violet = scenes. -->
    <Color x:Key="BgColor">#0A0C10</Color>
    <Color x:Key="S1Color">#1A1F29</Color>   <!-- module surface -->
    <Color x:Key="S2Color">#12161D</Color>   <!-- inset / well (waveform, meters) -->
    <Color x:Key="S3Color">#232A36</Color>   <!-- control well -->
    <Color x:Key="S4Color">#2C3442</Color>   <!-- control hover / knob track -->
    <Color x:Key="HairColor">#2C3442</Color> <!-- hairline border -->
    <Color x:Key="TextColor">#E8EDF4</Color>
    <Color x:Key="DimColor">#9AA6B8</Color>
    <Color x:Key="FaintColor">#5D6B80</Color>
    <Color x:Key="AccentColor">#2FD6E0</Color>   <!-- primary accent — beat / active (cyan) -->
    <Color x:Key="AccentInkColor">#06232A</Color>
    <Color x:Key="RedColor">#FF5470</Color>      <!-- blackout / strobe -->
    <Color x:Key="GreenColor">#46D369</Color>    <!-- play / locked -->
    <Color x:Key="AmberColor">#F5A623</Color>    <!-- cue / warning -->
    <Color x:Key="VioletColor">#9B6BFF</Color>   <!-- visual / scenes -->

    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="S1" Color="{StaticResource S1Color}" />
    <SolidColorBrush x:Key="S2" Color="{StaticResource S2Color}" />
    <SolidColorBrush x:Key="S3" Color="{StaticResource S3Color}" />
    <SolidColorBrush x:Key="S4" Color="{StaticResource S4Color}" />
    <SolidColorBrush x:Key="Hair" Color="{StaticResource HairColor}" />
    <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="Dim" Color="{StaticResource DimColor}" />
    <SolidColorBrush x:Key="Faint" Color="{StaticResource FaintColor}" />
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentInk" Color="{StaticResource AccentInkColor}" />
    <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
    <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="Violet" Color="{StaticResource VioletColor}" />

    <!-- Retint Fluent's accent so standard controls (buttons, selection, sliders) follow the cyan line. -->
    <Color x:Key="SystemAccentColor">#2FD6E0</Color>
    <Color x:Key="SystemAccentColorDark1">#26B7C0</Color>
    <Color x:Key="SystemAccentColorDark2">#1F9CA4</Color>
    <Color x:Key="SystemAccentColorDark3">#187C82</Color>
    <Color x:Key="SystemAccentColorLight1">#54DEE6</Color>
    <Color x:Key="SystemAccentColorLight2">#7BE7ED</Color>
    <Color x:Key="SystemAccentColorLight3">#A6EFF3</Color>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Liveolator.App/Theme/Spartan.axaml" />
  </Application.Styles>

</Application>
