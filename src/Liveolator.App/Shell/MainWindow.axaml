<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
        xmlns:controls="clr-namespace:Liveolator.App.Controls"
        xmlns:shell="clr-namespace:Liveolator.App.Shell"
        x:Class="Liveolator.App.Shell.MainWindow"
        x:DataType="shell:MainWindowViewModel"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        WindowState="FullScreen"
        SystemDecorations="None"
        Title="Liveolator"
        Background="{DynamicResource AppBackground}">

  <Window.Styles>
    <!-- Connection LED: faint when no device, dim when linked-idle, green on live MIDI signal.
         .live is listed last so it wins over .linked when a message is arriving. -->
    <Style Selector="Ellipse.led">
      <Setter Property="Fill" Value="{DynamicResource Faint}" />
    </Style>
    <Style Selector="Ellipse.led.linked">
      <Setter Property="Fill" Value="{DynamicResource Dim}" />
    </Style>
    <Style Selector="Ellipse.led.live">
      <Setter Property="Fill" Value="{DynamicResource MidiActive}" />
    </Style>
  </Window.Styles>

  <DockPanel LastChildFill="True">

    <!-- top status strip: where audio is routed + which MIDI gear is connected (green on signal) -->
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource Hair}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,8">

        <!-- audio routing -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Classes="mono faint" Text="OUT" />
          <TextBlock Classes="mono" Foreground="{DynamicResource Dim}" Text="{Binding Status.AudioOutputName}" />
        </StackPanel>

        <!-- CPU / memory of the running app -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding Status.HasMetrics}">
          <TextBlock Classes="mono faint" Text="CPU" />
          <TextBlock Classes="mono" Foreground="{DynamicResource Dim}" Text="{Binding Status.CpuText}" />
          <TextBlock Classes="mono faint" Text="RAM" Margin="8,0,0,0" />
          <TextBlock Classes="mono" Foreground="{DynamicResource Dim}" Text="{Binding Status.MemoryText}" />
        </StackPanel>

        <!-- MIDI connectivity + activity, preceded by the global OS-volume knob -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <!-- Global computer master volume: drives the OS system volume (affects every app). Hidden on
               hosts where the OS volume cannot be controlled. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      IsVisible="{Binding SystemVolume.IsAvailable}">
            <TextBlock Classes="mono faint" VerticalAlignment="Center" Text="VOL" />
            <controls:Knob Width="26" Height="26" VerticalAlignment="Center"
                           Value="{Binding SystemVolume.Volume.Value}"
                           IsEnabled="{Binding SystemVolume.Volume.IsEnabled}"
                           ArcBrush="{DynamicResource Accent}"
                           ToolTip.Tip="Computer master volume (affects every app)" />
          </StackPanel>
          <Border Width="1" Height="16" Background="{DynamicResource Hair}" VerticalAlignment="Center"
                  IsVisible="{Binding SystemVolume.IsAvailable}" />
          <TextBlock Classes="mono faint" Text="MIDI" />
          <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                   Classes="led"
                   Classes.linked="{Binding Status.MidiInputConnected}"
                   Classes.live="{Binding Status.MidiActive}" />
          <TextBlock Classes="mono" Foreground="{DynamicResource Dim}" Text="{Binding Status.MidiInputName}" />
          <TextBlock Classes="mono faint"
                     Text="{Binding Status.MidiFeedbackName, StringFormat='· LED {0}'}"
                     IsVisible="{Binding Status.MidiFeedbackName, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
          <Button Classes="spartan"
                  Padding="7,4"
                  Margin="8,0,0,0"
                  ToolTip.Tip="MIDI Learn — bind a control to the next hardware message"
                  Command="{Binding MidiLearn.ToggleCommand}">
            <!-- 5-pin DIN connector: the universal MIDI glyph (ring + pins) -->
            <Viewbox Width="16" Height="16">
              <Canvas Width="24" Height="24">
                <Ellipse Width="22" Height="22" Canvas.Left="1" Canvas.Top="1"
                         Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                <Ellipse Width="3" Height="3" Canvas.Left="10.5" Canvas.Top="4"  Fill="{DynamicResource Accent}" />
                <Ellipse Width="3" Height="3" Canvas.Left="5"    Canvas.Top="8"  Fill="{DynamicResource Accent}" />
                <Ellipse Width="3" Height="3" Canvas.Left="16"   Canvas.Top="8"  Fill="{DynamicResource Accent}" />
                <Ellipse Width="3" Height="3" Canvas.Left="7"    Canvas.Top="14" Fill="{DynamicResource Accent}" />
                <Ellipse Width="3" Height="3" Canvas.Left="14"   Canvas.Top="14" Fill="{DynamicResource Accent}" />
              </Canvas>
            </Viewbox>
          </Button>
          <Button x:Name="FullScreenButton"
                  Classes="spartan"
                  Padding="7,4"
                  Margin="8,0,0,0"
                  ToolTip.Tip="Toggle borderless full screen (F11)"
                  Click="OnFullScreenClick">
            <!-- expand-corners: toggle borderless full screen -->
            <Viewbox Width="16" Height="16">
              <Path Data="M2,6 L2,2 L6,2 M14,6 L14,2 L10,2 M2,10 L2,14 L6,14 M14,10 L14,14 L10,14"
                    Stroke="{DynamicResource Accent}" StrokeThickness="2"
                    StrokeLineCap="Round" StrokeJoin="Round" />
            </Viewbox>
          </Button>
        </StackPanel>

      </Grid>
    </Border>

    <!-- tab strip -->
    <Border DockPanel.Dock="Top"
            BorderBrush="{DynamicResource Hair}"
            BorderThickness="0,0,0,1">
      <ListBox Classes="tabs"
               ItemsSource="{Binding Tabs}"
               SelectedItem="{Binding CurrentTab, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="shell:TabItemViewModel">
            <TextBlock Text="{Binding Title}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource Accent}"
            Padding="14,8"
            IsVisible="{Binding MidiLearn.IsEnabled}">
      <TextBlock Foreground="{DynamicResource AccentInk}"
                 HorizontalAlignment="Center"
                 Text="{Binding MidiLearn.Status}" />
    </Border>

    <!-- audio-engine warning: a missing native library (bass_fx / BASS) makes every track load fail, so
         playback and SYNC silently do nothing. Surface it up front instead of leaving dead controls. -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource Amber}"
            Padding="14,8"
            IsVisible="{Binding HasAudioEngineWarning}">
      <TextBlock Foreground="{DynamicResource AccentInk}"
                 HorizontalAlignment="Center"
                 TextWrapping="Wrap"
                 Text="{Binding AudioEngineWarning}" />
    </Border>

    <!-- selected page (resolved by ViewLocator) -->
    <ContentControl Margin="16" Content="{Binding CurrentTab.Page}" />

  </DockPanel>
</Window>
