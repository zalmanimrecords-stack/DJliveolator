<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vis="clr-namespace:Liveolator.App.Features.VisualLibrary"
             xmlns:lib="clr-namespace:Liveolator.App.Features.Libraries"
             x:Class="Liveolator.App.Features.VisualLibrary.VisualLibraryView"
             x:DataType="vis:VisualLibraryViewModel">

  <Grid RowDefinitions="Auto,Auto,*">

    <!-- sub-bar -->
    <Grid Row="0" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,0,0,12">
      <Button Grid.Column="0" Classes="spartan" Content="Add folder"
              Click="OnAddFolder" Margin="0,0,8,0" />
      <Button Grid.Column="1" Classes="accent" Content="Scan" Command="{Binding ScanCommand}" />
      <TextBox Grid.Column="2" Classes="spartan" Margin="12,0"
               Watermark="Search asset name…" Text="{Binding SearchText}" />
      <TextBlock Grid.Column="3" Classes="mono faint" VerticalAlignment="Center"
                 Text="{Binding ScanStatus}" />
    </Grid>

    <!-- filter bar: kind + status + clear -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                MinWidth="110" ToolTip.Tip="Filter by kind">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vis:VisualFilterLabelConverter.Instance}, ConverterParameter=kind}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}"
                MinWidth="110" ToolTip.Tip="Filter by probe status">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={x:Static vis:VisualFilterLabelConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Border Width="1" Background="{DynamicResource Hair}" Margin="4,2" />

      <Button Classes="spartan" Content="Clear" Command="{Binding ClearFiltersCommand}"
              ToolTip.Tip="Reset all filters" />
    </StackPanel>

    <!-- main: table | detail -->
    <Grid Grid.Row="2" ColumnDefinitions="*,320">

      <!-- asset table -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Assets" Margin="0,0,0,10" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="14,2.4*,64,84,64,72" Margin="11,0,9,8">
            <TextBlock Grid.Column="1" Classes="faint" Text="NAME" />
            <TextBlock Grid.Column="2" Classes="faint" Text="KIND" />
            <TextBlock Grid.Column="3" Classes="faint" Text="SIZE" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="faint" Text="TIME" HorizontalAlignment="Right" Margin="0,0,12,0" />
            <TextBlock Grid.Column="5" Classes="faint" Text="STATUS" />
          </Grid>
          <ListBox Classes="rows"
                   ItemsSource="{Binding Assets}"
                   SelectedItem="{Binding SelectedAsset}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vis:VisualAssetRowViewModel">
                <Grid ColumnDefinitions="14,2.4*,64,84,64,72" VerticalAlignment="Center">
                  <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                           Fill="{Binding Status, Converter={x:Static lib:StatusToBrushConverter.Instance}}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="faint" Text="{Binding KindGlyph}" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding KindText}" />
                  <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Dimensions}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Classes="mono faint" Text="{Binding Duration}" HorizontalAlignment="Right" Margin="0,0,12,0" />
                  <TextBlock Grid.Column="5" Classes="muted" Text="{Binding StatusText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- detail -->
      <Border Grid.Column="1" Classes="panel" Margin="16,0,0,0">
        <StackPanel Margin="16" Spacing="16">
          <TextBlock Classes="section" Text="Asset" />

          <TextBlock Classes="faint"
                     Text="Select an asset to see details."
                     IsVisible="{Binding SelectedAsset, Converter={x:Static ObjectConverters.IsNull}}" />

          <StackPanel Spacing="16"
                      IsVisible="{Binding SelectedAsset, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="2">
              <TextBlock FontSize="14" Text="{Binding SelectedAsset.Title}" TextWrapping="Wrap" />
              <TextBlock Classes="mono faint" Text="{Binding SelectedAsset.SubLine}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- preview: decoded image, or an extracted video frame -->
            <Border Height="180" Background="{DynamicResource S1}"
                    BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="3">
              <Grid>
                <Image Source="{Binding PreviewBitmap}" Stretch="Uniform" Margin="6"
                       IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                           Text="{Binding PreviewMessage}"
                           IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                <TextBlock Classes="faint" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Loading…" IsVisible="{Binding IsPreviewLoading}" />
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                <TextBlock Classes="faint" Text="KIND" />
                <TextBlock Classes="accent" FontSize="14" Text="{Binding SelectedAsset.KindText}" />
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                <TextBlock Classes="faint" Text="DIMENSIONS" />
                <TextBlock Classes="mono accent" FontSize="14" Text="{Binding SelectedAsset.Dimensions}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,14,0,0">
                <TextBlock Classes="faint" Text="DURATION" />
                <TextBlock Classes="mono" FontSize="14" Text="{Binding SelectedAsset.Duration}" />
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2" Margin="0,14,0,0">
                <TextBlock Classes="faint" Text="STATUS" />
                <TextBlock Classes="muted" FontSize="14" Text="{Binding SelectedAsset.StatusText}" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="8">
              <TextBlock Classes="faint" Text="FILE" />
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Name" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedAsset.FileName}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Path" />
                  <TextBlock Grid.Column="1" Classes="mono faint" Text="{Binding SelectedAsset.Path}" TextWrapping="Wrap" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <Button Classes="spartan" Content="Delete from disk"
                    Foreground="{DynamicResource Red}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding DeleteSelectedCommand}"
                    ToolTip.Tip="Permanently delete this file from disk and remove it from the library" />
          </StackPanel>
        </StackPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>
