<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:comp="clr-namespace:Liveolator.App.Composition"
             xmlns:dj="clr-namespace:Liveolator.App.Features.Dj"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Dj.DjProView"
             x:DataType="dj:DjProViewModel">

  <!-- DJ PRO — a denser DJ surface built ALONGSIDE the DJ tab (new files only; the DJ tab is untouched).
       It drives the SAME shared decks + mixer, but with DJ-PRO-specific compact deck/mixer views: a smaller
       jog, tighter buttons, the FX knobs + four hot cues in one row above each deck, and NO FX-mode
       button (the FX are their own knobs now). Everything is designed to fit one screen with no scroll; the
       browser row collapses on laptop tiers (code-behind, via DjBrowserLayout) and opens on wide/4K. -->
  <Grid Name="RootGrid" RowDefinitions="Auto,*,0">

    <!-- WAVEFORMS — the shared dual strip (bound to the shared decks), with the ZOOM knob on the right. -->
    <Border Grid.Row="0" Classes="panel" Margin="0,0,0,6">
      <Grid ColumnDefinitions="*,Auto" Margin="10,6">
        <StackPanel Grid.Column="0" Spacing="5">
          <Grid ColumnDefinitions="20,*">
            <TextBlock Grid.Column="0" Classes="mono accent" FontWeight="SemiBold"
                       VerticalAlignment="Center" Text="A" />
            <controls:DeckWaveform Grid.Column="1" DataContext="{Binding Decks.DeckA}" Folded="True" />
          </Grid>
          <Grid ColumnDefinitions="20,*">
            <TextBlock Grid.Column="0" Classes="mono" FontWeight="SemiBold"
                       Foreground="{DynamicResource DeckBIdentity}" VerticalAlignment="Center" Text="B" />
            <controls:DeckWaveform Grid.Column="1" DataContext="{Binding Decks.DeckB}" Folded="True" CombAtTop="True" />
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="4" Margin="14,0,0,0"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="ZOOM" />
          <controls:Knob Width="{DynamicResource SizeKnobZoom}" Height="{DynamicResource SizeKnobZoom}" DefaultValue="0.55"
                         ArcBrush="{DynamicResource Accent}" Value="{Binding Decks.WaveformZoom}"
                         ToolTip.Tip="Zoom both waveforms" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- PERFORMANCE: each deck column is [FX · HOT CUES] / [LOOP · SYNC · TRACK] / deck, around the mixer. The racks
         share one row above each deck; UniformGrid skips the hidden STEMS rack, so FX + cues split the row when stems are off. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" Margin="0,0,10,0">
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,6">
          <dj:DeckStemRackView IsVisible="{x:Static comp:StemsFeature.IsEnabled}" Margin="0,0,3,0" DataContext="{Binding StemRackA}" />
          <dj:DeckFxRackView Margin="3,0,3,0" DataContext="{Binding FxRackA}" />
          <dj:DjProHotCueStripView Margin="3,0,0,0" DataContext="{Binding Decks.DeckA}" />
        </UniformGrid>
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,6">
          <dj:DjProLoopView Margin="0,0,3,0" DataContext="{Binding Decks.DeckA}" />
          <dj:DjProSyncView Margin="3,0,3,0" DataContext="{Binding Decks.DeckA}" />
          <dj:DjProTrackBrowseView Margin="3,0,0,0" PrevCommand="{Binding BrowsePrevACommand}" NextCommand="{Binding BrowseNextACommand}" />
        </UniformGrid>
        <dj:DjProDeckView Grid.Row="2" DataContext="{Binding Decks.DeckA}" />
      </Grid>

      <dj:DjProMixerView Grid.Column="1" Margin="0,0,10,0" DataContext="{Binding Decks.Mixer}" />

      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto">
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,6">
          <dj:DeckStemRackView IsVisible="{x:Static comp:StemsFeature.IsEnabled}" Margin="0,0,3,0" DataContext="{Binding StemRackB}" />
          <dj:DeckFxRackView Margin="3,0,3,0" DataContext="{Binding FxRackB}" />
          <dj:DjProHotCueStripView Margin="3,0,0,0" DataContext="{Binding Decks.DeckB}" />
        </UniformGrid>
        <UniformGrid Grid.Row="1" Rows="1" Margin="0,0,0,6">
          <dj:DjProLoopView Margin="0,0,3,0" DataContext="{Binding Decks.DeckB}" />
          <dj:DjProSyncView Margin="3,0,3,0" DataContext="{Binding Decks.DeckB}" />
          <dj:DjProTrackBrowseView Margin="3,0,0,0" PrevCommand="{Binding BrowsePrevBCommand}" NextCommand="{Binding BrowseNextBCommand}" />
        </UniformGrid>
        <dj:DjProDeckView Grid.Row="2" DataContext="{Binding Decks.DeckB}" />
      </Grid>
    </Grid>

    <!-- Browser (collapsible per tier): 0 on laptop, a band on wide/4K. -->
    <Border Grid.Row="2" IsVisible="{Binding HasBrowser}" Margin="0,12,0,0" ClipToBounds="True">
      <dj:DjBrowserView DataContext="{Binding Browser}" />
    </Border>
  </Grid>
</UserControl>
