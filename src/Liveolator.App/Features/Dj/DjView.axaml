<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dj="clr-namespace:Liveolator.App.Features.Dj"
             xmlns:shared="clr-namespace:Liveolator.App.Features.Shared"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Dj.DjView"
             x:DataType="dj:DjViewModel">

  <!-- Single-screen DJ layout (no page scroll): a thin dual-waveform strip on top, the two decks +
       mixer filling the middle (* row), and the SET as a fixed bottom strip with its own scroll. The
       decks are the hero — each is a jog-first DjDeckView — so the screen reads like a hardware deck. -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- WAVEFORMS — two compressed rows; the amber kick band shows each track's kicks so the downbeats
         line up by eye for sync. Click a strip to seek that deck. ZOOM knob (right) zooms BOTH strips. -->
    <Border Grid.Row="0" Classes="panel" Margin="0,0,0,10">
      <Grid ColumnDefinitions="*,Auto" Margin="14,8">
        <StackPanel Grid.Column="0" Spacing="5">
          <Grid ColumnDefinitions="20,*">
            <TextBlock Grid.Column="0" Classes="mono accent" FontWeight="SemiBold"
                       VerticalAlignment="Center" Text="A" />
            <Border Grid.Column="1" Height="44" Background="{DynamicResource S2}"
                    BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
              <controls:WaveformStrip Peaks="{Binding DeckA.Waveform}" KickPeaks="{Binding DeckA.KickPeaks}"
                                      MidPeaks="{Binding DeckA.MidPeaks}" HighPeaks="{Binding DeckA.HighPeaks}"
                                      BarBrush="{DynamicResource WaveformAhead}" PlayedBrush="{DynamicResource Waveform}"
                                      KickBrush="{DynamicResource Kick}"
                                      MidBrush="{DynamicResource WaveMid}" HighBrush="{DynamicResource WaveHigh}"
                                      Progress="{Binding DeckA.Progress}" ZoomWindow="{Binding DeckA.ZoomWindow}"
                                      BeatGrid="{Binding DeckA.BeatGrid}"
                                      KickAnchor="{Binding DeckA.KickAnchorFraction}"
                                      SeekCommand="{Binding DeckA.SeekCommand}" />
            </Border>
          </Grid>
          <Grid ColumnDefinitions="20,*">
            <TextBlock Grid.Column="0" Classes="mono accent" FontWeight="SemiBold"
                       VerticalAlignment="Center" Text="B" />
            <Border Grid.Column="1" Height="44" Background="{DynamicResource S2}"
                    BorderBrush="{DynamicResource Hair}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
              <controls:WaveformStrip Peaks="{Binding DeckB.Waveform}" KickPeaks="{Binding DeckB.KickPeaks}"
                                      MidPeaks="{Binding DeckB.MidPeaks}" HighPeaks="{Binding DeckB.HighPeaks}"
                                      BarBrush="{DynamicResource WaveformAhead}" PlayedBrush="{DynamicResource Waveform}"
                                      KickBrush="{DynamicResource Kick}"
                                      MidBrush="{DynamicResource WaveMid}" HighBrush="{DynamicResource WaveHigh}"
                                      Progress="{Binding DeckB.Progress}" ZoomWindow="{Binding DeckB.ZoomWindow}"
                                      BeatGrid="{Binding DeckB.BeatGrid}"
                                      KickAnchor="{Binding DeckB.KickAnchorFraction}"
                                      SeekCommand="{Binding DeckB.SeekCommand}" />
            </Border>
          </Grid>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="4" Margin="14,0,0,0"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="ZOOM" />
          <controls:Knob Width="40" Height="40" DefaultValue="0.55"
                         ArcBrush="{DynamicResource Accent}"
                         Value="{Binding Decks.WaveformZoom}"
                         ToolTip.Tip="Zoom both waveforms — drag up to zoom in (see the kicks), down for the whole track" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- DECK A · MIXER · DECK B — the decks are DJ-specific (jog-first); the mixer is the shared module. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,300,*" Margin="0,0,0,10">
      <dj:DjDeckView Grid.Column="0" DataContext="{Binding DeckA}" Margin="0,0,16,0" />
      <dj:DjMixerView Grid.Column="1" DataContext="{Binding Mixer}" Margin="0,0,16,0" />
      <dj:DjDeckView Grid.Column="2" DataContext="{Binding DeckB}" />
    </Grid>

    <!-- THE SET (live Now/Next/Later queue) — fixed bottom strip; the list scrolls inside its bounds so
         the page itself never scrolls. -->
    <Border Grid.Row="2" Classes="panel" MaxHeight="220">
      <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="16,12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
          <TextBlock Classes="section" VerticalAlignment="Center" Text="SET · NOW / NEXT / LATER" />
          <Button Grid.Column="1" Classes="spartan" Content="Load from Library"
                  Command="{Binding LoadFromLibraryCommand}" Margin="0,0,8,0" />
          <Button Grid.Column="2" Classes="spartan" Content="Skip ▸"
                  Command="{Binding SkipCommand}" />
        </Grid>

        <!-- empty hint -->
        <TextBlock Grid.Row="1" Classes="faint" IsVisible="{Binding IsSetEmpty}"
                   Text="Set is empty — load the scanned library, or scan folders in the LIBRARIES tab." />

        <!-- the tracklist -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding !IsSetEmpty}">
          <ItemsControl ItemsSource="{Binding Set}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="dj:SetEntryViewModel">
                <Border BorderBrush="{DynamicResource Hair}" BorderThickness="0,0,0,1" Padding="0,6">
                  <Border.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Add to Deck A" Command="{Binding Menu.LoadToDeckACommand}" />
                      <MenuItem Header="Add to Deck B" Command="{Binding Menu.LoadToDeckBCommand}"
                                IsVisible="{Binding Menu.CanLoadToDeckB}" />
                      <Separator />
                      <MenuItem Header="Analyze again + online lookup"
                                Command="{Binding Menu.AnalyzeAgainCommand}" />
                      <MenuItem Header="Edit BPM / key / genre / notes"
                                Command="{Binding Menu.EditMetadataCommand}" />
                      <Separator />
                      <MenuItem Header="Add to playlist" ItemsSource="{Binding Menu.AddToPlaylistItems}">
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="shared:MenuActionViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                    </MenuFlyout>
                  </Border.ContextFlyout>
                  <Grid ColumnDefinitions="64,*,Auto">
                    <TextBlock Grid.Column="0" Classes="mono faint" Text="{Binding StateLabel}"
                               Classes.accent="{Binding IsNow}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Title}" />
                    <Button Grid.Column="2" Classes="key" Content="✕"
                            Command="{Binding RemoveCommand}" IsVisible="{Binding !IsNow}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- DECK B QUEUE — tracks loaded onto a playing deck B land here and play when its current
             track ends. Future entries are removable; the playing one is protected. -->
        <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding !IsDeckBQueueEmpty}">
          <TextBlock Classes="faint" Text="DECK B · QUEUE" />
          <ScrollViewer MaxHeight="96">
            <ItemsControl ItemsSource="{Binding DeckBQueue}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dj:SetEntryViewModel">
                  <Grid ColumnDefinitions="64,*,Auto" Margin="0,3">
                    <TextBlock Grid.Column="0" Classes="mono faint" Text="{Binding StateLabel}"
                               Classes.accent="{Binding IsNow}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="key" Content="✕"
                            Command="{Binding RemoveCommand}" IsVisible="{Binding !IsNow}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <!-- PLAYED HISTORY (B5) — shown only once tracks have played; read-only, most-recent first -->
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,10,0,0" IsVisible="{Binding !IsPlayedEmpty}">
          <TextBlock Classes="faint" Text="PLAYED" />
          <ScrollViewer MaxHeight="84">
            <ItemsControl ItemsSource="{Binding Played}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="dj:SetEntryViewModel">
                  <Grid ColumnDefinitions="64,*" Margin="0,3">
                    <TextBlock Grid.Column="0" Classes="mono faint" Text="{Binding StateLabel}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
