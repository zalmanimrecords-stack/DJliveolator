<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             xmlns:shared="clr-namespace:Liveolator.App.Features.Shared"
             x:Class="Liveolator.App.Features.Dj.DjDeckView"
             x:DataType="m:DeckViewModel">

  <UserControl.Styles>
    <!-- A still-suggested (auto-placed) hot cue is ghosted; it solidifies once the DJ presses (commits) it. -->
    <Style Selector="Button.cuepad.suggested">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
  </UserControl.Styles>

  <!-- DJ-tab deck: the same DeckViewModel as the LIVE tab, but laid out jog-first (the platter is the
       hero, hot cues flank it) so the DJ screen reads like a hardware deck and fits one screen. Pitch
       stays hardware/MIDI-only (DeckPitch) — no on-screen pitch fader, matching the LIVE deck. -->
  <Border Classes="panel">
    <!-- Cap + center the deck content so the controls cluster as one coherent column (the 176px jog plus
         its 84px hot-cue/loop flanks ~= 360) instead of the platter floating alone in a wide deck column.
         A plain MaxWidth keeps the square jog undistorted (no aspect-ratio binding). -->
    <StackPanel Margin="14,10" Spacing="8" MaxWidth="360" HorizontalAlignment="Center">

      <!-- header: badge · title/meta · elapsed/remaining -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="3"
                BorderBrush="{DynamicResource AccentLightColor}" BorderThickness="1"
                VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0" />
              <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="14"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DeckId}" />
        </Border>
        <!-- One header for both decks: the loaded track's name is always the title (the A/B badge already
             shows which deck this is), and the Key·BPM·duration line shows once that meta is known. -->
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Classes="mono accent" FontSize="11" Text="{Binding Meta}" IsVisible="{Binding HasTrackMeta}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
          <TextBlock Classes="mono" FontSize="12" HorizontalAlignment="Right"
                     Text="{Binding ElapsedText}" ToolTip.Tip="Time elapsed in the track" />
          <TextBlock Classes="mono accent" FontSize="12" HorizontalAlignment="Right"
                     Text="{Binding RemainingText}" ToolTip.Tip="Time remaining in the track" />
        </StackPanel>
      </Grid>

      <!-- JOG row: hot cues (2×2) · platter · loop. The jog shows the playhead (progress ring + spindle)
           and drags to seek (DeckSeek), flanking the platter the way a controller lays pads beside it. -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center" Width="84">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="HOT CUES" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="key" Content="{Binding HotCueBankLabel}" Height="20"
                    Padding="6,0" Command="{Binding ToggleHotCueBankCommand}" IsEnabled="{Binding CanHotCue}"
                    ToolTip.Tip="Switch hot-cue bank (A = cues 1-4, B = cues 5-8)" />
          </Grid>
          <ItemsControl ItemsSource="{Binding VisibleHotCues}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:HotCuePadViewModel">
                <!-- Shows the cue's name (or pad number) + color strip; auto cues render ghosted. -->
                <Button Classes="key cuepad" Classes.on="{Binding IsSet}" Classes.suggested="{Binding IsAuto}"
                        Height="34" Command="{Binding TriggerCommand}" IsEnabled="{Binding IsEnabled}"
                        Margin="0,0,4,4" ToolTip.Tip="{Binding CueLabel}">
                  <Grid RowDefinitions="*,3">
                    <TextBlock Grid.Row="0" Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Rectangle Grid.Row="1" Height="3" RadiusX="1" RadiusY="1" IsVisible="{Binding IsSet}"
                               Fill="{Binding Color, Converter={x:Static shared:CueColorToBrushConverter.Instance}}" />
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <controls:Jog Grid.Column="1" Width="144" Height="144" HorizontalAlignment="Center"
                      ArcBrush="{DynamicResource Accent}"
                      Progress="{Binding Progress}" SeekCommand="{Binding SeekCommand}"
                      IsEnabled="{Binding IsEnabled}"
                      KickPeaks="{Binding KickPeaks}" IsKickActive="{Binding IsPlaying}"
                      ToolTip.Tip="Drag the platter to seek — clockwise advances, counter-clockwise rewinds" />

        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center" Width="84">
          <TextBlock Classes="section" Text="LOOP" />
          <Button Classes="key" Classes.on="{Binding IsLooping}" Content="4" Height="34"
                  Command="{Binding LoopCommand}" IsEnabled="{Binding CanLoop}"
                  ToolTip.Tip="Toggle a 1-bar loop" />
          <TextBlock Classes="section" Text="NUDGE" Margin="0,4,0,0" />
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="key" Content="◄" Height="30" Margin="0,0,3,0"
                    Command="{Binding NudgeBendDownCommand}" IsEnabled="{Binding CanPitchBend}"
                    ToolTip.Tip="Nudge — tap to bend the deck slower (beats drift back); tap repeatedly to beat-match. No skip." />
            <Button Grid.Column="1" Classes="key" Content="►" Height="30"
                    Command="{Binding NudgeBendUpCommand}" IsEnabled="{Binding CanPitchBend}"
                    ToolTip.Tip="Nudge — tap to bend the deck faster (beats drift forward); tap repeatedly to beat-match. No skip." />
          </Grid>
        </StackPanel>
      </Grid>

      <!-- transport: CUE · Play · Sync · Key-lock — icon buttons. KEY LOCK lives here (one row up) so the
           deck fits one screen; it stays a toggle (lights when engaged). Tooltips carry the labels. -->
      <Grid ColumnDefinitions="*,1.3*,*,*">
        <Button Grid.Column="0" Classes="key" Content="⏮" FontSize="16" Margin="0,0,4,0"
                Command="{Binding CueCommand}" IsEnabled="{Binding CanCue}"
                ToolTip.Tip="Cue — jump to the cue point / track start" />
        <Button Grid.Column="1" Classes="play" Classes.on="{Binding IsPlaying}"
                Command="{Binding PlayPauseCommand}" Margin="0,0,4,0" ToolTip.Tip="Play / pause">
          <Path Data="M 0,0 L 13,8 L 0,16 Z" Fill="{DynamicResource Accent}" />
        </Button>
        <Button Grid.Column="2" Classes="key" Content="⇄" FontSize="16" Margin="0,0,4,0"
                Command="{Binding SyncCommand}" IsEnabled="{Binding CanSync}"
                ToolTip.Tip="Sync — match tempo + phase to the other deck (one-shot)" />
        <Button Grid.Column="3" Classes="key" Classes.on="{Binding IsKeyLock}" Content="🔒" FontSize="14"
                Command="{Binding KeyLockCommand}" IsEnabled="{Binding CanSync}"
                ToolTip.Tip="Key lock (master tempo): keep the pitch when changing tempo" />
      </Grid>

      <!-- KEY · pitch%: the loaded track's musical key (BPM-level prominence, from the catalog) on the left,
           the live signed pitch offset (DeckPitch, hardware/MIDI-driven) on the right. -->
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="section" VerticalAlignment="Center" Text="KEY" />
        <TextBlock Grid.Column="1" Classes="mono accent" Margin="8,0,0,0" FontSize="14"
                   VerticalAlignment="Center" Text="{Binding TrackKey}"
                   IsVisible="{Binding HasTrackKey}" ToolTip.Tip="Musical key of the loaded track" />
        <TextBlock Grid.Column="3" Classes="tick" VerticalAlignment="Center" Text="PITCH" />
        <TextBlock Grid.Column="4" Classes="mono" Margin="8,0,0,0" VerticalAlignment="Center"
                   Text="{Binding PitchPercentText}"
                   ToolTip.Tip="Pitch offset (percent of the real tempo)" />
      </Grid>

      <!-- BPM: horizontal fader (0..1 normalised) + nudge buttons for manual beat-sync -->
      <Border Classes="hardware-well" Padding="10,8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="section" VerticalAlignment="Center" Text="BPM" />
            <TextBlock Grid.Column="1" Classes="mono"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding Bpm, StringFormat='{}{0:0.0}'}"
                       IsEnabled="{Binding IsBpmEnabled}" />
            <TextBlock Grid.Column="2" Classes="tick" VerticalAlignment="Center" Text="±8%" />
          </Grid>
          <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding IsBpmEnabled}">
            <Button Grid.Column="0" Classes="key" Content="◄" Width="34" Height="26"
                    Command="{Binding NudgeLeftCommand}"
                    ToolTip.Tip="Nudge BPM −0.1 (manual beat-sync)" />
            <controls:Fader Grid.Column="1" Margin="6,0" Height="26"
                            Orientation="Horizontal"
                            Value="{Binding BpmFaderValue}" />
            <Button Grid.Column="2" Classes="key" Content="►" Width="34" Height="26"
                    Command="{Binding NudgeRightCommand}"
                    ToolTip.Tip="Nudge BPM +0.1 (manual beat-sync)" />
          </Grid>
          <!-- GRID edit: hand-correct the analyzed beat grid so it lands on the kicks. Re-tempo (−/+, ½/×2)
               or SET (slide a beat line onto the kick under the playhead). Inaudible — unlike the BPM nudge
               above, these change only the GRID/sync tempo, never the playing pitch. -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" IsEnabled="{Binding IsBpmEnabled}">
            <TextBlock Grid.Column="0" Classes="tick" VerticalAlignment="Center" Text="GRID" Margin="0,0,6,0" />
            <Button Grid.Column="1" Classes="key" Content="−" Width="28" Height="22"
                    Command="{Binding GridBpmDownCommand}" ToolTip.Tip="Grid tempo −1 BPM (does not change pitch)" />
            <Button Grid.Column="2" Classes="key" Content="+" Width="28" Height="22" Margin="4,0,0,0"
                    Command="{Binding GridBpmUpCommand}" ToolTip.Tip="Grid tempo +1 BPM (does not change pitch)" />
            <Button Grid.Column="3" Classes="key" Content="½" Width="28" Height="22" Margin="4,0,0,0"
                    Command="{Binding GridHalveCommand}" ToolTip.Tip="Halve the grid tempo (octave fix)" />
            <Button Grid.Column="4" Classes="key" Content="×2" Width="28" Height="22" Margin="4,0,0,0"
                    Command="{Binding GridDoubleCommand}" ToolTip.Tip="Double the grid tempo (octave fix)" />
            <Button Grid.Column="6" Classes="key" Content="SET" Width="44" Height="22"
                    Command="{Binding SetGridHereCommand}" ToolTip.Tip="Put a beat line on the kick under the playhead" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- EQ + filter knobs live on the MIXER now (per-channel strips, DjMixerView) — the way a hardware
           DJ mixer groups the channel EQ. Pitch stays hardware/MIDI-only via DeckPitch (no on-screen knob). -->
    </StackPanel>
  </Border>
</UserControl>
