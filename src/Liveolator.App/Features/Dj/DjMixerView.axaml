<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Dj.DjMixerView"
             x:DataType="m:MixerViewModel">

  <!-- DJ-tab mixer: the same MixerViewModel as the LIVE tab, but height-compact (shorter channel
       faders, tighter wells) so the whole DJ screen fits one window without scrolling. The LIVE
       MixerView keeps its taller, roomier layout. -->
  <Border Classes="panel">
    <!-- Cap the control cluster so the wells/faders gather at a sensible width instead of floating
         across the fixed 300px DJ-mixer column. Column width itself is owned by the parent layout. -->
    <StackPanel Margin="14,12" Spacing="10" MaxWidth="270" HorizontalAlignment="Center">

      <Border Classes="hardware-well" Padding="10,8">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="accent" VerticalAlignment="Center" Text="A" Margin="0,0,8,0" />
            <!-- Crossfader is the primary blend control, so it carries more height (36) than the
                 secondary BPM-nudge fader (26) to reflect its priority. -->
            <controls:Fader Grid.Column="1" Orientation="Horizontal" Height="36"
                            Value="{Binding Crossfader.Value}" IsEnabled="{Binding Crossfader.IsEnabled}" />
            <TextBlock Grid.Column="2" Classes="accent" VerticalAlignment="Center" Text="B" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="hardware-well" Padding="8,10">
        <!-- [A EQ/FLT] · A fader · shared dB scale · B fader · [B EQ/FLT] — the channel EQ + filter knobs
             flank each volume fader, the way a hardware mixer stacks them on the channel strip. The knobs
             are compact (28px) so the strip stays inside the DJ-mixer column without scrolling. -->
        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
              HorizontalAlignment="Center">
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="accent" FontSize="14" HorizontalAlignment="Center" Text="A" />
          <TextBlock Grid.Row="0" Grid.Column="3" Classes="accent" FontSize="14" HorizontalAlignment="Center" Text="B" />

          <!-- A channel EQ + filter (left of fader A) -->
          <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Spacing="2" Margin="0,0,8,0">
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelA.EqHigh.Value}" IsEnabled="{Binding ChannelA.EqHigh.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="HI" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelA.EqMid.Value}" IsEnabled="{Binding ChannelA.EqMid.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="MID" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelA.EqLow.Value}" IsEnabled="{Binding ChannelA.EqLow.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="LOW" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelA.Filter.Value}" IsEnabled="{Binding ChannelA.Filter.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="FLT" />
          </StackPanel>

          <controls:Fader Grid.Row="1" Grid.Column="1" Width="44" Height="150" HorizontalAlignment="Center"
                          Value="{Binding ChannelGainA.Value}" Level="{Binding LevelA}"
                          IsEnabled="{Binding ChannelGainA.IsEnabled}" />

          <Grid Grid.Row="1" Grid.Column="2" Width="36" Height="150" RowDefinitions="*,*,*,*,*,*,*,*,*,*">
            <TextBlock Grid.Row="0" Classes="tick" HorizontalAlignment="Center" Text="+6" />
            <TextBlock Grid.Row="1" Classes="tick" HorizontalAlignment="Center" Text="+3" />
            <TextBlock Grid.Row="2" Classes="tick" HorizontalAlignment="Center" Text="0" />
            <TextBlock Grid.Row="3" Classes="tick" HorizontalAlignment="Center" Text="-3" />
            <TextBlock Grid.Row="4" Classes="tick" HorizontalAlignment="Center" Text="-6" />
            <TextBlock Grid.Row="5" Classes="tick" HorizontalAlignment="Center" Text="-10" />
            <TextBlock Grid.Row="6" Classes="tick" HorizontalAlignment="Center" Text="-15" />
            <TextBlock Grid.Row="7" Classes="tick" HorizontalAlignment="Center" Text="-20" />
            <TextBlock Grid.Row="8" Classes="tick" HorizontalAlignment="Center" Text="-30" />
            <TextBlock Grid.Row="9" Classes="tick" HorizontalAlignment="Center" Text="-inf" />
          </Grid>

          <controls:Fader Grid.Row="1" Grid.Column="3" Width="44" Height="150" HorizontalAlignment="Center"
                          Value="{Binding ChannelGainB.Value}" Level="{Binding LevelB}"
                          IsEnabled="{Binding ChannelGainB.IsEnabled}" />

          <!-- B channel EQ + filter (right of fader B) -->
          <StackPanel Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Spacing="2" Margin="8,0,0,0">
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelB.EqHigh.Value}" IsEnabled="{Binding ChannelB.EqHigh.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="HI" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelB.EqMid.Value}" IsEnabled="{Binding ChannelB.EqMid.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="MID" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelB.EqLow.Value}" IsEnabled="{Binding ChannelB.EqLow.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="LOW" />
            <controls:Knob Width="28" Height="28" HorizontalAlignment="Center"
                           Value="{Binding ChannelB.Filter.Value}" IsEnabled="{Binding ChannelB.Filter.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="FLT" />
          </StackPanel>

          <Button Grid.Row="2" Grid.Column="1" Classes="key mixer" Classes.on="{Binding IsCueA}" Content="CUE"
                  Command="{Binding CueACommand}" Margin="0,8,0,0" />

          <!-- Mixer-wide EQ cut-depth as a 3-detent knob, seated between the two CUE buttons (EQ -12 dB /
               DEEP -24 dB / KILL full). The caption shows the active mode; double-click resets to KILL. -->
          <StackPanel Grid.Row="2" Grid.Column="2" Spacing="1" Margin="0,8,0,0"
                      VerticalAlignment="Top" HorizontalAlignment="Center"
                      ToolTip.Tip="EQ cut depth, all channels">
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUT" />
            <controls:Knob Width="34" Height="34" Detents="3" DefaultValue="1" HorizontalAlignment="Center"
                           Value="{Binding EqCut.Value}" IsEnabled="{Binding EqCut.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding EqCut.ModeLabel}" />
          </StackPanel>

          <Button Grid.Row="2" Grid.Column="3" Classes="key mixer" Classes.on="{Binding IsCueB}" Content="CUE"
                  Command="{Binding CueBCommand}" Margin="0,8,0,0" />
        </Grid>
      </Border>

      <Border Classes="hardware-well" Padding="10,8">
        <Grid ColumnDefinitions="*,14,*">
          <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Classes="section" HorizontalAlignment="Center" Text="LEVEL" />
            <controls:Knob Width="48" Height="48"
                           Value="{Binding CueLevel.Value}"
                           IsEnabled="{Binding CueLevel.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="MIN   MAX" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
            <TextBlock Classes="section" HorizontalAlignment="Center" Text="MIX" />
            <controls:Knob Width="48" Height="48"
                           Value="{Binding CueMix.Value}"
                           IsEnabled="{Binding CueMix.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUE  MASTER" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Master "smart limiter": SAFE↔SMART toggle (program-dependent release that adapts to what is
           playing) + Character (Transparent↔Punchy) and Ceiling (true-peak) knobs. The brick-wall peak
           guarantee always holds; SMART only reshapes the release so kicks don't pump (doc 11). -->
      <!-- Compact (single tick row per knob) so the extra well still fits the one-screen DJ fold. -->
      <Border Classes="hardware-well" Padding="10,6">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Classes="section" VerticalAlignment="Center" Text="LIMITER" />
          <!-- Lit (.on) = SMART; unlit = SAFE fixed-release brick wall. Mirrors the CUE-button pattern. -->
          <Button Grid.Row="0" Grid.Column="2" Classes="key mixer" Classes.on="{Binding IsSmartLimiter}"
                  HorizontalAlignment="Right" Command="{Binding LimiterSmartCommand}" Content="SMART"
                  ToolTip.Tip="SMART = release adapts to what is playing; SAFE = fixed brick-wall release" />

          <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,6,12,0" HorizontalAlignment="Center"
                      ToolTip.Tip="Gentle ↔ Hard: how aggressively the smart release reacts">
            <controls:Knob Width="36" Height="36" HorizontalAlignment="Center"
                           Value="{Binding LimiterCharacter.Value}"
                           IsEnabled="{Binding LimiterCharacter.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CHARACTER" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Spacing="2" Margin="12,6,0,0" HorizontalAlignment="Center"
                      ToolTip.Tip="True-peak output ceiling (low ↔ hot)">
            <controls:Knob Width="36" Height="36" HorizontalAlignment="Center"
                           Value="{Binding LimiterCeiling.Value}"
                           IsEnabled="{Binding LimiterCeiling.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CEILING" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</UserControl>
