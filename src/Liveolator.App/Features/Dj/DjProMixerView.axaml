<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Dj.DjProMixerView"
             x:DataType="m:MixerViewModel">

  <!-- DJ PRO mixer: mirrors the DJ tab's proven single-Grid channel strip (so nothing clips), but WITHOUT
       the FX-mode button (the FX are their own knobs in the deck racks) and WITHOUT the disabled stem-mute
       row (per-stem knobs come in Phase 3). The DJ tab's own DjMixerView is untouched. -->
  <Border Classes="panel">
    <StackPanel Classes="mixer-root" Margin="14,8" Spacing="6"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border Classes="hardware-well" Padding="8,6">
        <StackPanel Spacing="8">
          <!-- Rows: 0 = A/B headers + centre CUT selector; 1 = channel EQ + volume faders + dB scale;
               2 = crossfader; 3 = CUE. (No FX button, no STEMS row.) -->
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                HorizontalAlignment="Center">
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="accent" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Text="A" />
            <TextBlock Grid.Row="0" Grid.Column="3" Classes="accent" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource DeckBIdentity}" Text="B" />

            <!-- mixer-wide EQ cut depth (EQ / DEEP / KILL) -->
            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="1"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        ToolTip.Tip="EQ cut depth, all channels">
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUT" />
              <controls:Knob Width="{DynamicResource SizeKnobCut}" Height="{DynamicResource SizeKnobCut}"
                             Detents="3" DefaultValue="1" HorizontalAlignment="Center"
                             Value="{Binding EqCut.Value}" IsEnabled="{Binding EqCut.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding EqCut.ModeLabel}" />
            </StackPanel>

            <!-- A channel EQ + filter (RST resets HI/MID/LOW to flat). No FX button. -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalAlignment="Top" Spacing="2" Margin="0,0,8,0">
              <Button Classes="key mixer" Content="RST" FontSize="9" Padding="6,3" MinWidth="0"
                      HorizontalAlignment="Center" Margin="0,0,0,2"
                      Command="{Binding ChannelA.ResetEqCommand}" ToolTip.Tip="Reset this channel's EQ (HI / MID / LOW) to flat" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelA.EqHigh.Value}" IsEnabled="{Binding ChannelA.EqHigh.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelA.EqHighLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelA.EqMid.Value}" IsEnabled="{Binding ChannelA.EqMid.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelA.EqMidLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelA.EqLow.Value}" IsEnabled="{Binding ChannelA.EqLow.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelA.EqLowLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelA.Filter.Value}" IsEnabled="{Binding ChannelA.Filter.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelA.FilterLabel}" />
            </StackPanel>

            <controls:Fader Grid.Row="1" Grid.Column="1"
                            Width="{DynamicResource SizeFaderChannelWidth}" Height="{DynamicResource SizeFaderChannelHeight}"
                            HorizontalAlignment="Center"
                            Value="{Binding ChannelGainA.Value}" Level="{Binding LevelA}"
                            IsEnabled="{Binding ChannelGainA.IsEnabled}" />

            <Grid Grid.Row="1" Grid.Column="2" Width="36" Height="{DynamicResource SizeFaderChannelHeight}"
                  RowDefinitions="*,*,*,*,*,*,*,*,*,*">
              <TextBlock Grid.Row="0" Classes="tick" HorizontalAlignment="Center" Text="+6" />
              <TextBlock Grid.Row="1" Classes="tick" HorizontalAlignment="Center" Text="+3" />
              <TextBlock Grid.Row="2" Classes="tick" HorizontalAlignment="Center" Text="0" />
              <TextBlock Grid.Row="3" Classes="tick" HorizontalAlignment="Center" Text="-3" />
              <TextBlock Grid.Row="4" Classes="tick" HorizontalAlignment="Center" Text="-6" />
              <TextBlock Grid.Row="5" Classes="tick" HorizontalAlignment="Center" Text="-10" />
              <TextBlock Grid.Row="6" Classes="tick" HorizontalAlignment="Center" Text="-15" />
              <TextBlock Grid.Row="7" Classes="tick" HorizontalAlignment="Center" Text="-20" />
              <TextBlock Grid.Row="8" Classes="tick" HorizontalAlignment="Center" Text="-30" />
              <TextBlock Grid.Row="9" Classes="tick" HorizontalAlignment="Center" Text="-inf" />
            </Grid>

            <controls:Fader Grid.Row="1" Grid.Column="3"
                            Width="{DynamicResource SizeFaderChannelWidth}" Height="{DynamicResource SizeFaderChannelHeight}"
                            HorizontalAlignment="Center"
                            Value="{Binding ChannelGainB.Value}" Level="{Binding LevelB}"
                            IsEnabled="{Binding ChannelGainB.IsEnabled}" />

            <!-- B channel EQ + filter. No FX button. -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="4" VerticalAlignment="Top" Spacing="2" Margin="8,0,0,0">
              <Button Classes="key mixer" Content="RST" FontSize="9" Padding="6,3" MinWidth="0"
                      HorizontalAlignment="Center" Margin="0,0,0,2"
                      Command="{Binding ChannelB.ResetEqCommand}" ToolTip.Tip="Reset this channel's EQ (HI / MID / LOW) to flat" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelB.EqHigh.Value}" IsEnabled="{Binding ChannelB.EqHigh.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelB.EqHighLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelB.EqMid.Value}" IsEnabled="{Binding ChannelB.EqMid.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelB.EqMidLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelB.EqLow.Value}" IsEnabled="{Binding ChannelB.EqLow.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelB.EqLowLabel}" />
              <controls:Knob Width="{DynamicResource SizeKnobEq}" Height="{DynamicResource SizeKnobEq}" HorizontalAlignment="Center"
                             Value="{Binding ChannelB.Filter.Value}" IsEnabled="{Binding ChannelB.Filter.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding ChannelB.FilterLabel}" />
            </StackPanel>

            <!-- crossfader under the faders, spanning both channels, A/B snap flanking -->
            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Spacing="3" Margin="0,10,0,0">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="key mixer" Content="A" FontSize="12" Padding="8,3" MinWidth="28"
                        VerticalAlignment="Center" Margin="0,0,8,0"
                        Command="{Binding CrossfadeToACommand}" ToolTip.Tip="Snap crossfader fully to A" />
                <controls:Fader Grid.Column="1" Orientation="Horizontal" Height="30"
                                Value="{Binding Crossfader.Value}" IsEnabled="{Binding Crossfader.IsEnabled}" />
                <Button Grid.Column="2" Classes="key mixer" Content="B" FontSize="12" Padding="8,3" MinWidth="28"
                        VerticalAlignment="Center" Margin="8,0,0,0"
                        Command="{Binding CrossfadeToBCommand}" ToolTip.Tip="Snap crossfader fully to B" />
              </Grid>
            </StackPanel>

            <Button Grid.Row="3" Grid.Column="1" Classes="key mixer" Classes.on="{Binding IsCueA}" Content="CUE"
                    Command="{Binding CueACommand}" Margin="0,8,0,0" />
            <Button Grid.Row="3" Grid.Column="3" Classes="key mixer" Classes.on="{Binding IsCueB}" Content="CUE"
                    Command="{Binding CueBCommand}" Margin="0,8,0,0" />
          </Grid>

          <!-- headphone cue LEVEL + MIX -->
          <Grid ColumnDefinitions="*,14,*">
            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="section" HorizontalAlignment="Center" Text="LEVEL" />
              <controls:Knob Width="{DynamicResource SizeKnobCue}" Height="{DynamicResource SizeKnobCue}"
                             Value="{Binding CueLevel.Value}" IsEnabled="{Binding CueLevel.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="MIN   MAX" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="section" HorizontalAlignment="Center" Text="MIX" />
              <controls:Knob Width="{DynamicResource SizeKnobCue}" Height="{DynamicResource SizeKnobCue}"
                             Value="{Binding CueMix.Value}" IsEnabled="{Binding CueMix.IsEnabled}" />
              <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUE  MASTER" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
