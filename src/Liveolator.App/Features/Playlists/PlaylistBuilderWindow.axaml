<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pl="clr-namespace:Liveolator.App.Features.Playlists"
        xmlns:lib="clr-namespace:Liveolator.App.Features.Libraries"
        xmlns:shared="clr-namespace:Liveolator.App.Features.Shared"
        x:Class="Liveolator.App.Features.Playlists.PlaylistBuilderWindow"
        x:DataType="pl:PlaylistBuilderViewModel"
        Width="860" Height="600"
        MinWidth="680" MinHeight="420"
        Title="Playlists — build a set"
        Background="{StaticResource Bg}">

  <DockPanel Margin="16" LastChildFill="True">

    <!-- top bar: open/save/delete a named set + send to live -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox MinWidth="160" ItemsSource="{Binding SavedPlaylists}"
                  SelectedItem="{Binding SelectedSaved}" PlaceholderText="Saved sets…" />
        <Button Classes="spartan" Content="Open" Command="{Binding OpenCommand}" />
        <Button Classes="spartan" Content="Delete" Command="{Binding DeleteCommand}" />
        <Button Classes="spartan" Content="New" Command="{Binding NewCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox Classes="spartan" Width="260" Watermark="Set name" Text="{Binding Name}" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
        <Button Classes="spartan" Content="Send to live set"
                Command="{Binding SendToLiveSetCommand}" IsVisible="{Binding CanSendToLiveSet}" />
      </StackPanel>
    </StackPanel>

    <!-- status -->
    <TextBlock DockPanel.Dock="Bottom" Classes="mono faint" Margin="0,12,0,0" Text="{Binding Status}" />

    <!-- two panes: library picker | current set -->
    <Grid ColumnDefinitions="*,16,*">

      <!-- library -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="LIBRARY" Margin="0,0,0,8" />
          <TextBox DockPanel.Dock="Top" Classes="spartan" Margin="0,0,0,8"
                   Watermark="Search title, artist, key…" Text="{Binding LibrarySearch}" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="accent" Content="Add →" Command="{Binding AddTrackCommand}" />
            <Button Classes="spartan" Content="Auto-fill (harmonic)" Command="{Binding AutoFillCommand}" />
          </StackPanel>
          <ListBox Classes="rows" ItemsSource="{Binding Library}"
                   SelectedItem="{Binding SelectedLibraryTrack}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="lib:TrackRowViewModel">
                <Grid ColumnDefinitions="*,46,40" VerticalAlignment="Center">
                  <Grid.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Add to Deck A" Command="{Binding Menu.LoadToDeckACommand}" />
                      <MenuItem Header="Add to Deck B" Command="{Binding Menu.LoadToDeckBCommand}"
                                IsVisible="{Binding Menu.CanLoadToDeckB}" />
                      <Separator />
                      <MenuItem Header="Analyze again + online lookup"
                                Command="{Binding Menu.AnalyzeAgainCommand}" />
                      <MenuItem Header="Edit BPM / key / genre / notes"
                                Command="{Binding Menu.EditMetadataCommand}" />
                      <Separator />
                      <MenuItem Header="Add to playlist" ItemsSource="{Binding Menu.AddToPlaylistItems}">
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="shared:MenuActionViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                    </MenuFlyout>
                  </Grid.ContextFlyout>
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Bpm}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="mono accent" Text="{Binding Key}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- current set -->
      <Border Grid.Column="2" Classes="panel">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="SET" Margin="0,0,0,8" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Classes="spartan" Content="↑" Command="{Binding MoveUpCommand}" />
            <Button Classes="spartan" Content="↓" Command="{Binding MoveDownCommand}" />
            <Button Classes="spartan" Content="Remove" Command="{Binding RemoveCommand}" />
          </StackPanel>
          <ListBox Classes="rows" ItemsSource="{Binding Current}"
                   SelectedItem="{Binding SelectedCurrent}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="pl:PlaylistTrackViewModel">
                <Grid ColumnDefinitions="*,46,40" VerticalAlignment="Center">
                  <Grid.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Add to Deck A" Command="{Binding Menu.LoadToDeckACommand}" />
                      <MenuItem Header="Add to Deck B" Command="{Binding Menu.LoadToDeckBCommand}"
                                IsVisible="{Binding Menu.CanLoadToDeckB}" />
                      <Separator />
                      <MenuItem Header="Analyze again + online lookup"
                                Command="{Binding Menu.AnalyzeAgainCommand}" />
                      <MenuItem Header="Edit BPM / key / genre / notes"
                                Command="{Binding Menu.EditMetadataCommand}" />
                      <Separator />
                      <MenuItem Header="Add to playlist" ItemsSource="{Binding Menu.AddToPlaylistItems}">
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="shared:MenuActionViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                    </MenuFlyout>
                  </Grid.ContextFlyout>
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Bpm}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="mono accent" Text="{Binding Key}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>
</Window>
