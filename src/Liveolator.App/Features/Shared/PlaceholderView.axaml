<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Liveolator.App.Features.Shared"
             x:Class="Liveolator.App.Features.Shared.PlaceholderView"
             x:DataType="shared:PlaceholderViewModel">
  <Border Classes="panel">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
      <TextBlock Classes="section" HorizontalAlignment="Center" Text="{Binding Title}" />
      <TextBlock Classes="faint" HorizontalAlignment="Center" Text="{Binding Message}" />
    </StackPanel>
  </Border>
</UserControl>
