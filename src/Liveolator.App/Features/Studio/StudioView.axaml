<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:studio="clr-namespace:Liveolator.App.Features.Studio"
             xmlns:lib="clr-namespace:Liveolator.App.Features.Libraries"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Studio.StudioView"
             x:DataType="studio:StudioViewModel">

  <DockPanel LastChildFill="True">

    <!-- project + transport bar -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox MinWidth="170" ItemsSource="{Binding SavedProjects}"
                  SelectedItem="{Binding SelectedSaved}" PlaceholderText="Saved projects…" />
        <Button Classes="spartan" Content="Open" Command="{Binding OpenCommand}" />
        <Button Classes="spartan" Content="Delete" Command="{Binding DeleteCommand}" />
        <Button Classes="spartan" Content="New" Command="{Binding NewCommand}" />
        <Border Width="1" Background="{DynamicResource Hair}" Margin="4,2" />
        <TextBox Classes="spartan" Width="200" Watermark="Project name" Text="{Binding Name}" />
        <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
        <Button Classes="spartan" Content="Render WAV" Command="{Binding RenderCommand}"
                IsVisible="{Binding CanRender}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button Classes="accent" Content="▶ Play" Command="{Binding PlayCommand}"
                IsVisible="{Binding CanPlay}" />
        <Button Classes="spartan" Content="■ Stop" Command="{Binding StopCommand}"
                IsVisible="{Binding CanPlay}" />
        <TextBlock Classes="mono accent" VerticalAlignment="Center" Text="PLAYING"
                   IsVisible="{Binding IsPlaying}" />
        <Border Width="1" Background="{DynamicResource Hair}" Margin="4,2" />
        <TextBlock Classes="faint" VerticalAlignment="Center" Text="Zoom" />
        <Slider Width="160" Minimum="2" Maximum="40" Value="{Binding PixelsPerSecond}" VerticalAlignment="Center" />
        <TextBlock Classes="faint" VerticalAlignment="Center" Text="BPM" Margin="8,0,0,0" />
        <TextBox Classes="spartan" Width="64" Text="{Binding Bpm}" />
      </StackPanel>
    </StackPanel>

    <!-- status -->
    <TextBlock DockPanel.Dock="Bottom" Classes="mono faint" Margin="0,12,0,0" Text="{Binding Status}" />

    <!-- library | timeline -->
    <Grid ColumnDefinitions="300,16,*">

      <!-- LIBRARY -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="LIBRARY" Margin="0,0,0,8" />
          <TextBox DockPanel.Dock="Top" Classes="spartan" Margin="0,0,0,8"
                   Watermark="Search title, artist, key…" Text="{Binding LibrarySearch}" />
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Classes="faint" VerticalAlignment="Center" Text="Deck" />
            <ComboBox SelectedIndex="{Binding TargetDeck}" MinWidth="64">
              <ComboBoxItem>A</ComboBoxItem>
              <ComboBoxItem>B</ComboBoxItem>
              <ComboBoxItem>C</ComboBoxItem>
              <ComboBoxItem>D</ComboBoxItem>
            </ComboBox>
            <Button Classes="accent" Content="Add →" Command="{Binding AddClipCommand}" />
          </StackPanel>
          <ListBox Classes="rows" ItemsSource="{Binding Library}"
                   SelectedItem="{Binding SelectedLibraryTrack}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="lib:TrackRowViewModel">
                <Grid ColumnDefinitions="*,46,40" VerticalAlignment="Center">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Bpm}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Classes="mono accent" Text="{Binding Key}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- TIMELINE -->
      <Border Grid.Column="2" Classes="panel">
        <DockPanel Margin="12">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <TextBlock Classes="section" Text="TIMELINE" />
            <Button Classes="spartan" Content="Remove clip" Command="{Binding RemoveClipCommand}" />
            <TextBlock Classes="faint" VerticalAlignment="Center"
                       Text="{Binding SelectedClip.Title, StringFormat='· {0}'}" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Lanes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="studio:StudioLaneViewModel">
                  <Grid ColumnDefinitions="40,*" Height="68" Margin="0,0,0,6">
                    <Border Grid.Column="0" Background="{DynamicResource S3}" CornerRadius="3" Margin="0,0,6,0">
                      <TextBlock Classes="mono accent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Text="{Binding Label}" />
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource S2}" CornerRadius="3">
                      <ItemsControl ItemsSource="{Binding Clips}" MinWidth="2400">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <Canvas Height="64" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Styles>
                          <Style Selector="ContentPresenter" x:DataType="studio:StudioClipViewModel">
                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                            <Setter Property="Canvas.Top" Value="2" />
                            <Setter Property="Width" Value="{Binding Width}" />
                          </Style>
                        </ItemsControl.Styles>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="studio:StudioClipViewModel">
                            <Button Classes="clip" Height="60" Padding="0"
                                    Command="{Binding ((studio:StudioViewModel)DataContext).SelectClipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                              <Grid RowDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Classes="mono" FontSize="10" Margin="4,2,4,0"
                                           Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <controls:WaveformStrip Grid.Row="1" Margin="2"
                                                        Peaks="{Binding Peaks}"
                                                        KickPeaks="{Binding KickPeaks}"
                                                        MidPeaks="{Binding MidPeaks}"
                                                        HighPeaks="{Binding HighPeaks}" />
                              </Grid>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </DockPanel>

  <UserControl.Styles>
    <Style Selector="Button.clip">
      <Setter Property="Background" Value="{DynamicResource S3}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="Button.clip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource S4}" />
    </Style>
  </UserControl.Styles>
</UserControl>
