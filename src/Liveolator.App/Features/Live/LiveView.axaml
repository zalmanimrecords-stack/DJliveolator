<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:live="clr-namespace:Liveolator.App.Features.Live"
             x:Class="Liveolator.App.Features.Live.LiveView"
             x:DataType="live:LiveViewModel">

  <!-- LIVE = the VISUAL performance screen. The DJ console used to sit on top of this page (the same
       DjConsoleView control over the shared decks) and was removed: the audio side is DJ PRO's job, and
       sharing one screen meant neither half got the room it needed. The decks are still driven from here
       in the view-model — LiveViewModel's render timer advances the SHARED playheads, which is what keeps
       DJ PRO's zoomed waveform moving — so this is a display change, not a wiring change.
       The on-screen Push macro-encoder strip was dropped earlier (the Push encoders still drive visual
       macros through the controller mapping, not this panel). -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <!-- MaxWidth is tier-dependent (Theme/ResponsiveLayout.axaml via the .live-root class) so the page uses
         the full width on large/4K screens instead of the old fixed 1440 cap. -->
    <StackPanel Classes="live-root" Spacing="8" Margin="0,0,0,6">

      <!-- PROGRAM OUT + VISUAL CONTROL. No section header: the whole page is the visuals now, and a
           label over everything labels nothing. -->
      <Grid ColumnDefinitions="*,320">
        <ContentControl Grid.Column="0" Content="{Binding ProgramOut}" Margin="0,0,10,0" />
        <ContentControl Grid.Column="1" Content="{Binding VisualControl}" />
      </Grid>

      <!-- Live Mode state cue — collapses to nothing when live; the static device chrome was decorative
           (the real MIDI/audio status lives in the top status bar) and was removed to reclaim vertical space. -->
      <TextBlock Classes="mono faint" Margin="2,0" IsVisible="{Binding !IsLiveModeEnabled}"
                 Text="Live Mode off — controls disabled" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
