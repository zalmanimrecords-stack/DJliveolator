<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:live="clr-namespace:Liveolator.App.Features.Live"
             x:Class="Liveolator.App.Features.Live.LiveView"
             x:DataType="live:LiveViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" MaxWidth="1440" Margin="0,0,0,8">

      <!-- PROGRAM OUT + BEAT ENGINE -->
      <Grid ColumnDefinitions="*,320">
        <ContentControl Grid.Column="0" Content="{Binding ProgramOut}" Margin="0,0,16,0" />
        <ContentControl Grid.Column="1" Content="{Binding Beat}" />
      </Grid>

      <!-- DECK A · MIXER · DECK B -->
      <Grid ColumnDefinitions="*,200,*">
        <ContentControl Grid.Column="0" Content="{Binding DeckA}" Margin="0,0,16,0" />
        <ContentControl Grid.Column="1" Content="{Binding Mixer}" Margin="0,0,16,0" />
        <ContentControl Grid.Column="2" Content="{Binding DeckB}" />
      </Grid>

      <!-- SCENES + MASTER/FX -->
      <Grid ColumnDefinitions="*,280">
        <ContentControl Grid.Column="0" Content="{Binding SceneGrid}" Margin="0,0,16,0" />
        <ContentControl Grid.Column="1" Content="{Binding MasterFx}" />
      </Grid>

      <!-- PUSH ENCODERS -->
      <ContentControl Content="{Binding MacroEncoders}" />

      <!-- FOOTER (static status — no live telemetry backend yet) -->
      <Border Classes="panel">
        <StackPanel Orientation="Horizontal" Spacing="24" Margin="16,10">
          <TextBlock Classes="mono faint" Text="Push 1 · User mode" />
          <TextBlock Classes="mono faint" Text="CMD STUDIO 2A" />
          <TextBlock Classes="mono faint" Text="Master + Cue" />
          <TextBlock Classes="mono faint" IsVisible="{Binding !IsLiveModeEnabled}"
                     Text="Live Mode off — controls disabled" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
