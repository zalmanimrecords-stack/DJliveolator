<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Live.Modules.MixerView"
             x:DataType="m:MixerViewModel">

  <Border Classes="panel" MinHeight="430">
    <StackPanel Margin="20" Spacing="18">

      <Grid ColumnDefinitions="Auto,*,Auto">
        <TextBlock Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontSize="15" LetterSpacing="2.2" Text="MIXER" />
        <Button Grid.Column="2" Classes="spartan" Content="LINK" FontSize="10"
                BorderBrush="{StaticResource Accent}" Foreground="{StaticResource Accent}"
                IsEnabled="False" />
      </Grid>

      <Border Classes="hardware-well" Padding="8,12">
      <Grid ColumnDefinitions="*,*">
        <StackPanel Grid.Column="0" Spacing="10" HorizontalAlignment="Center">
          <TextBlock Classes="accent" FontSize="15" HorizontalAlignment="Center" Text="A" />
          <Grid ColumnDefinitions="34,46">
            <Grid Width="34" Height="210" RowDefinitions="*,*,*,*,*,*,*,*,*,*">
              <TextBlock Grid.Row="0" Classes="tick" HorizontalAlignment="Right" Text="+6" />
              <TextBlock Grid.Row="1" Classes="tick" HorizontalAlignment="Right" Text="+3" />
              <TextBlock Grid.Row="2" Classes="tick" HorizontalAlignment="Right" Text="0" />
              <TextBlock Grid.Row="3" Classes="tick" HorizontalAlignment="Right" Text="-3" />
              <TextBlock Grid.Row="4" Classes="tick" HorizontalAlignment="Right" Text="-6" />
              <TextBlock Grid.Row="5" Classes="tick" HorizontalAlignment="Right" Text="-10" />
              <TextBlock Grid.Row="6" Classes="tick" HorizontalAlignment="Right" Text="-15" />
              <TextBlock Grid.Row="7" Classes="tick" HorizontalAlignment="Right" Text="-20" />
              <TextBlock Grid.Row="8" Classes="tick" HorizontalAlignment="Right" Text="-30" />
              <TextBlock Grid.Row="9" Classes="tick" HorizontalAlignment="Right" Text="-inf" />
            </Grid>
            <controls:Fader Grid.Column="1" Width="46" Height="210" HorizontalAlignment="Center"
                            Value="{Binding ChannelGainA.Value}" IsEnabled="{Binding ChannelGainA.IsEnabled}" />
          </Grid>
          <Button Classes="key mixer" Classes.on="{Binding IsCueA}" Content="CUE"
                  Command="{Binding CueACommand}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Center">
          <TextBlock FontSize="15" HorizontalAlignment="Center" Text="B" />
          <Grid ColumnDefinitions="34,46">
            <Grid Width="34" Height="210" RowDefinitions="*,*,*,*,*,*,*,*,*,*">
              <TextBlock Grid.Row="0" Classes="tick" HorizontalAlignment="Right" Text="+6" />
              <TextBlock Grid.Row="1" Classes="tick" HorizontalAlignment="Right" Text="+3" />
              <TextBlock Grid.Row="2" Classes="tick" HorizontalAlignment="Right" Text="0" />
              <TextBlock Grid.Row="3" Classes="tick" HorizontalAlignment="Right" Text="-3" />
              <TextBlock Grid.Row="4" Classes="tick" HorizontalAlignment="Right" Text="-6" />
              <TextBlock Grid.Row="5" Classes="tick" HorizontalAlignment="Right" Text="-10" />
              <TextBlock Grid.Row="6" Classes="tick" HorizontalAlignment="Right" Text="-15" />
              <TextBlock Grid.Row="7" Classes="tick" HorizontalAlignment="Right" Text="-20" />
              <TextBlock Grid.Row="8" Classes="tick" HorizontalAlignment="Right" Text="-30" />
              <TextBlock Grid.Row="9" Classes="tick" HorizontalAlignment="Right" Text="-inf" />
            </Grid>
            <controls:Fader Grid.Column="1" Width="46" Height="210" HorizontalAlignment="Center"
                            Value="{Binding ChannelGainB.Value}" IsEnabled="{Binding ChannelGainB.IsEnabled}" />
          </Grid>
          <Button Classes="key mixer" Classes.on="{Binding IsCueB}" Content="CUE"
                  Command="{Binding CueBCommand}" />
        </StackPanel>
      </Grid>
      </Border>

      <Border BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="accent" VerticalAlignment="Center" Text="A" Margin="0,0,8,0" />
          <controls:Fader Grid.Column="1" Orientation="Horizontal" Height="30"
                          Value="{Binding Crossfader.Value}" IsEnabled="{Binding Crossfader.IsEnabled}" />
          <TextBlock Grid.Column="2" Classes="accent" VerticalAlignment="Center" Text="B" Margin="8,0,0,0" />
        </Grid>
      </Border>
    </StackPanel>
  </Border>
</UserControl>
