<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Live.Modules.MixerView"
             x:DataType="m:MixerViewModel">

  <Border Classes="panel">
    <StackPanel Margin="20" Spacing="14">

      <Border Classes="hardware-well" Padding="10,10,10,12">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" HorizontalAlignment="Center" Text="CROSSFADE" />
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="accent" VerticalAlignment="Center" Text="A" Margin="0,0,8,0" />
            <controls:Fader Grid.Column="1" Orientation="Horizontal" Height="32"
                            Value="{Binding Crossfader.Value}" IsEnabled="{Binding Crossfader.IsEnabled}" />
            <TextBlock Grid.Column="2" Classes="accent" VerticalAlignment="Center" Text="B" Margin="8,0,0,0" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="hardware-well" Padding="8,12">
      <!-- A fader | one shared dB scale | B fader — faders centred on each side of the centre scale -->
      <Grid ColumnDefinitions="*,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="accent" FontSize="15" HorizontalAlignment="Center" Text="A" />
        <TextBlock Grid.Row="0" Grid.Column="2" Classes="accent" FontSize="15" HorizontalAlignment="Center" Text="B" />

        <controls:Fader Grid.Row="1" Grid.Column="0" Width="46" Height="210" HorizontalAlignment="Center"
                        Value="{Binding ChannelGainA.Value}" Level="{Binding LevelA}"
                        IsEnabled="{Binding ChannelGainA.IsEnabled}" />

        <Grid Grid.Row="1" Grid.Column="1" Width="40" Height="210" RowDefinitions="*,*,*,*,*,*,*,*,*,*">
          <TextBlock Grid.Row="0" Classes="tick" HorizontalAlignment="Center" Text="+6" />
          <TextBlock Grid.Row="1" Classes="tick" HorizontalAlignment="Center" Text="+3" />
          <TextBlock Grid.Row="2" Classes="tick" HorizontalAlignment="Center" Text="0" />
          <TextBlock Grid.Row="3" Classes="tick" HorizontalAlignment="Center" Text="-3" />
          <TextBlock Grid.Row="4" Classes="tick" HorizontalAlignment="Center" Text="-6" />
          <TextBlock Grid.Row="5" Classes="tick" HorizontalAlignment="Center" Text="-10" />
          <TextBlock Grid.Row="6" Classes="tick" HorizontalAlignment="Center" Text="-15" />
          <TextBlock Grid.Row="7" Classes="tick" HorizontalAlignment="Center" Text="-20" />
          <TextBlock Grid.Row="8" Classes="tick" HorizontalAlignment="Center" Text="-30" />
          <TextBlock Grid.Row="9" Classes="tick" HorizontalAlignment="Center" Text="-inf" />
        </Grid>

        <controls:Fader Grid.Row="1" Grid.Column="2" Width="46" Height="210" HorizontalAlignment="Center"
                        Value="{Binding ChannelGainB.Value}" Level="{Binding LevelB}"
                        IsEnabled="{Binding ChannelGainB.IsEnabled}" />

        <Button Grid.Row="2" Grid.Column="0" Classes="key mixer" Classes.on="{Binding IsCueA}" Content="CUE"
                Command="{Binding CueACommand}" Margin="0,10,0,0" />

        <!-- Mixer-wide EQ cut-depth as a 3-detent knob, seated between the two CUE buttons (EQ -12 dB /
             DEEP -24 dB / KILL full). The caption shows the active mode; double-click resets to KILL. -->
        <StackPanel Grid.Row="2" Grid.Column="1" Spacing="1" Margin="0,10,0,0"
                    VerticalAlignment="Top" HorizontalAlignment="Center"
                    ToolTip.Tip="EQ cut depth (all channels): EQ = gentle -12 dB · DEEP = -24 dB · KILL = full silence">
          <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUT" />
          <controls:Knob Width="38" Height="38" Detents="3" DefaultValue="1" HorizontalAlignment="Center"
                         Value="{Binding EqCut.Value}" IsEnabled="{Binding EqCut.IsEnabled}" />
          <TextBlock Classes="tick" HorizontalAlignment="Center" Text="{Binding EqCut.ModeLabel}" />
        </StackPanel>

        <Button Grid.Row="2" Grid.Column="2" Classes="key mixer" Classes.on="{Binding IsCueB}" Content="CUE"
                Command="{Binding CueBCommand}" Margin="0,10,0,0" />

        <!-- Per-stem mute (doc 32 §2b): DRUMS/BASS/VOCALS/OTHER as a 2×2 cluster under each CUE button,
             lit = the stem is playing. Enabled ONLY for a 4-stem deck (a track with a complete local
             stem set + the stems gate on); ghosted/disabled for a normal single-file track. -->
        <StackPanel Grid.Row="3" Grid.Column="0" Spacing="2" Margin="0,10,0,0" HorizontalAlignment="Center">
          <TextBlock Classes="tick" HorizontalAlignment="Center" Text="STEMS" />
          <ItemsControl ItemsSource="{Binding ChannelA.Stems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:StemMuteViewModel">
                <Button Classes="key mixer" Classes.on="{Binding IsAudible}" Content="{Binding Name}"
                        FontSize="8" Padding="4,2" MinWidth="0" Margin="1"
                        Command="{Binding ToggleCommand}" IsEnabled="{Binding IsAvailable}"
                        ToolTip.Tip="Mute / un-mute this stem (lit = playing)" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="2" Spacing="2" Margin="0,10,0,0" HorizontalAlignment="Center">
          <TextBlock Classes="tick" HorizontalAlignment="Center" Text="STEMS" />
          <ItemsControl ItemsSource="{Binding ChannelB.Stems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:StemMuteViewModel">
                <Button Classes="key mixer" Classes.on="{Binding IsAudible}" Content="{Binding Name}"
                        FontSize="8" Padding="4,2" MinWidth="0" Margin="1"
                        Command="{Binding ToggleCommand}" IsEnabled="{Binding IsAvailable}"
                        ToolTip.Tip="Mute / un-mute this stem (lit = playing)" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
      </Border>

      <Border Classes="hardware-well" Padding="12,10">
        <Grid ColumnDefinitions="*,18,*">
          <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Center">
            <TextBlock Classes="section" HorizontalAlignment="Center" Text="LEVEL" />
            <controls:Knob x:Name="CueLevelControl"
                           Width="58" Height="58"
                           Value="{Binding CueLevel.Value}"
                           IsEnabled="{Binding CueLevel.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="MIN      MAX" />
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Center">
            <TextBlock Classes="section" HorizontalAlignment="Center" Text="MIX" />
            <controls:Knob x:Name="CueMixControl"
                           Width="58" Height="58"
                           Value="{Binding CueMix.Value}"
                           IsEnabled="{Binding CueMix.IsEnabled}" />
            <TextBlock Classes="tick" HorizontalAlignment="Center" Text="CUE   MASTER" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </Border>
</UserControl>
