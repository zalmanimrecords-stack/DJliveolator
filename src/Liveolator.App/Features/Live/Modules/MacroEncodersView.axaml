<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Live.Modules.MacroEncodersView"
             x:DataType="m:MacroEncodersViewModel">

  <Border Classes="panel">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="section" Text="PUSH ENCODERS · VISUAL MACROS" />

      <ItemsControl ItemsSource="{Binding Encoders}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ContinuousControlViewModel">
            <StackPanel Spacing="6" Margin="6,0" HorizontalAlignment="Center">
              <controls:Knob Width="48" Height="48" HorizontalAlignment="Center"
                             Value="{Binding Value}" IsEnabled="{Binding IsEnabled}" />
              <TextBlock Classes="mono accent" FontSize="11" HorizontalAlignment="Center"
                         Text="{Binding Value, StringFormat='0.00'}" />
              <TextBlock Classes="faint" HorizontalAlignment="Center" Text="{Binding Label}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
