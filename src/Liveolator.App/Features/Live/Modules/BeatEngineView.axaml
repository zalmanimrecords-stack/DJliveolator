<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:live="clr-namespace:Liveolator.App.Features.Live"
             x:Class="Liveolator.App.Features.Live.Modules.BeatEngineView"
             x:DataType="m:BeatEngineViewModel">

  <Border Classes="panel">
    <StackPanel Margin="16" Spacing="12">
      <TextBlock Classes="section" Text="BEAT ENGINE" />

      <!-- readout -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint" Text="SOURCE" />
          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SourceLabel}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint" Text="TEMPO" />
          <TextBlock Grid.Column="1" Classes="mono accent" Text="{Binding Bpm}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint" Text="CONFIDENCE" />
          <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Confidence}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint" Text="LOCK" />
          <TextBlock Grid.Column="1" Classes="mono accent" IsVisible="{Binding IsLocked}" Text="ON" />
        </Grid>
      </StackPanel>

      <!-- pulse -->
      <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center" Margin="0,4">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <Ellipse Width="44" Height="44" HorizontalAlignment="Center" Fill="{StaticResource Accent}"
                   Opacity="{Binding IsBeat, Converter={x:Static live:PulseOpacityConverter.Instance}}" />
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="BEAT" />
        </StackPanel>
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <Ellipse Width="44" Height="44" HorizontalAlignment="Center" Fill="{StaticResource Red}"
                   Opacity="{Binding IsDownbeat, Converter={x:Static live:PulseOpacityConverter.Instance}}" />
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="DOWNBEAT" />
        </StackPanel>
      </StackPanel>

      <!-- phase -->
      <StackPanel Spacing="6">
        <TextBlock Classes="faint" Text="BEAT PHASE" />
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BeatPhase}" Height="5" />
        <TextBlock Classes="faint" Text="BAR PHASE" Margin="0,4,0,0" />
        <ProgressBar Minimum="0" Maximum="1" Value="{Binding BarPhase}" Height="5" />
        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
          <StackPanel Grid.Column="0" Spacing="2">
            <TextBlock Classes="faint" Text="BAR" />
            <TextBlock Classes="mono" Text="{Binding BarNumber}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="faint" Text="BEAT #" />
            <TextBlock Classes="mono" Text="{Binding BeatCount}" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <!-- key grid (mirrors the mock's 3×3) -->
      <UniformGrid Columns="3">
        <Button Classes="key" Content="Auto" IsEnabled="{Binding IsAutoEnabled}" Margin="0,0,6,6" />
        <Button Classes="key" Classes.on="{Binding IsLocked}" Content="Lock"
                Command="{Binding LockToggleCommand}" Margin="0,0,6,6" />
        <Button Classes="key" Content="Tap" Command="{Binding TapCommand}" Margin="0,0,0,6" />
        <Button Classes="key" Content="÷2" Command="{Binding HalfCommand}" Margin="0,0,6,6" />
        <Button Classes="key" Content="×2" Command="{Binding DoubleCommand}" Margin="0,0,6,6" />
        <Button Classes="key" Content="Set" Command="{Binding SetDownbeatCommand}" Margin="0,0,0,6" />
        <Button Classes="key" Content="Nudge−" Command="{Binding NudgeBackwardCommand}" Margin="0,0,6,0" />
        <Button Classes="key" Content="Nudge+" Command="{Binding NudgeForwardCommand}" Margin="0,0,6,0" />
        <Button Classes="key" Content="Reset" Command="{Binding ResetCommand}" />
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
