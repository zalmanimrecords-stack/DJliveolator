<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:Liveolator.App.Features.Live.Modules"
             xmlns:controls="clr-namespace:Liveolator.App.Controls"
             x:Class="Liveolator.App.Features.Live.Modules.DeckView"
             x:DataType="m:DeckViewModel">

  <Border Classes="panel">
    <StackPanel Margin="18" Spacing="14">

      <!-- header: badge · title · menu -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="3"
                BorderBrush="{DynamicResource AccentLightColor}" BorderThickness="1"
                VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="{DynamicResource AccentLightColor}" Offset="0" />
              <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock Foreground="{DynamicResource AccentInk}" FontWeight="SemiBold" FontSize="15"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding DeckId}" />
        </Border>
        <Panel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <!-- loaded: track title + Key · BPM · duration -->
          <StackPanel Spacing="1" IsVisible="{Binding HasTrackMeta}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="mono accent" FontSize="11" Text="{Binding Meta}" />
          </StackPanel>
          <!-- empty: deck id + placeholder -->
          <StackPanel Spacing="1" IsVisible="{Binding !HasTrackMeta}">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DeckId, StringFormat='Deck {0}'}" />
            <TextBlock Classes="faint" FontSize="11" Text="{Binding Title}" />
          </StackPanel>
        </Panel>
        <!-- time readout: elapsed over remaining, advancing with the playhead -->
        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
          <TextBlock Classes="mono" FontSize="12" HorizontalAlignment="Right"
                     Text="{Binding ElapsedText}" ToolTip.Tip="Time elapsed in the track" />
          <TextBlock Classes="mono accent" FontSize="12" HorizontalAlignment="Right"
                     Text="{Binding RemainingText}" ToolTip.Tip="Time remaining in the track" />
        </StackPanel>
      </Grid>

      <!-- waveform now lives in the two dedicated rows above the decks (see LiveView/DjView) so the kick
           transients of both decks sit side-by-side for beat-sync alignment. -->

      <!-- Hot cues: stored jump points inside the loaded track. Pads 1-4 emit DeckHotCue for their index
           and light from feedback once a cue point is set. -->
      <StackPanel Spacing="6">
        <TextBlock Classes="section" Text="HOT CUES" />
        <ItemsControl ItemsSource="{Binding HotCues}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:HotCuePadViewModel">
              <Button Classes="key" Classes.on="{Binding IsSet}"
                      Command="{Binding TriggerCommand}" IsEnabled="{Binding IsEnabled}" Margin="0,0,4,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- transport: CUE · Play · Sync (tempo match) -->
      <UniformGrid Columns="3">
        <Button Classes="key" Content="CUE" Command="{Binding CueCommand}"
                IsEnabled="{Binding CanCue}" Margin="0,0,4,0" />
        <Button Classes="play" Classes.on="{Binding IsPlaying}"
                Command="{Binding PlayPauseCommand}" Margin="0,0,4,0">
          <Path Data="M 0,0 L 13,8 L 0,16 Z" Fill="{DynamicResource Accent}" />
        </Button>
        <Button Classes="key" Content="SYNC"
                Command="{Binding SyncCommand}" IsEnabled="{Binding CanSync}"
                ToolTip.Tip="Match tempo + phase to the other deck (one-shot)" />
      </UniformGrid>

      <!-- BPM: horizontal fader (0..1 normalised via BpmFaderValue) + nudge buttons for manual beat-sync -->
      <Border Classes="hardware-well" Padding="10,8">
        <StackPanel Spacing="6">
          <!-- row 1: label · current value · range hint -->
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Classes="section" VerticalAlignment="Center" Text="BPM" />
            <TextBlock Grid.Column="1" Classes="mono"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="{Binding Bpm, StringFormat='{}{0:0.0}'}"
                       IsEnabled="{Binding IsBpmEnabled}" />
            <TextBlock Grid.Column="2" Classes="tick" VerticalAlignment="Center" Text="±8%" />
          </Grid>
          <!-- row 2: nudge left · slider · nudge right -->
          <Grid ColumnDefinitions="Auto,*,Auto" IsEnabled="{Binding IsBpmEnabled}">
            <Button Grid.Column="0" Classes="key" Content="◄" Width="34" Height="26"
                    Command="{Binding NudgeLeftCommand}"
                    ToolTip.Tip="Nudge BPM −0.1 (manual beat-sync)" />
            <controls:Fader Grid.Column="1" Margin="6,0" Height="26"
                            Orientation="Horizontal"
                            Value="{Binding BpmFaderValue}" />
            <Button Grid.Column="2" Classes="key" Content="►" Width="34" Height="26"
                    Command="{Binding NudgeRightCommand}"
                    ToolTip.Tip="Nudge BPM +0.1 (manual beat-sync)" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- KEY LOCK (master tempo): hold the musical key constant while the tempo/pitch fader moves. Toggles
           per-deck key-lock via DeckKeyLockToggle and lights from its active-state feedback (the LED model). -->
      <Button Classes="key" Classes.on="{Binding IsKeyLock}" Content="KEY LOCK"
              Command="{Binding KeyLockCommand}" IsEnabled="{Binding CanSync}"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              ToolTip.Tip="Key lock (master tempo): keep the pitch when changing tempo" />

      <!-- Track nudge: shift the waveform a small step (relative seek) for fine cueing / lining the track
           up. Direction follows the waveform-move convention (NOT an inverted binding): the arrow points the
           way the waveform slides, so ◄ slides the wave left = SeekForward, ► slides it right = SeekBack. The
           "WAVE" caption + the visible arrow keep that self-explanatory, and the NUDGE section label plus the
           waveform glyphs make this pair clearly distinct from the BPM ± nudge above. Step is configurable in
           Settings (default 0.1 s). -->
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="section" VerticalAlignment="Center" Text="NUDGE" />
          <TextBlock Grid.Column="2" Classes="tick" VerticalAlignment="Center" Text="WAVE" />
        </Grid>
        <UniformGrid Columns="2">
          <Button Classes="key" Margin="0,0,4,0"
                  Command="{Binding SeekForwardCommand}" IsEnabled="{Binding CanNudgeSeek}"
                  ToolTip.Tip="Nudge the track: slide the waveform left (fine cueing)">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="◄" />
              <TextBlock Classes="tick" VerticalAlignment="Center" Text="WAVE" />
            </StackPanel>
          </Button>
          <Button Classes="key"
                  Command="{Binding SeekBackCommand}" IsEnabled="{Binding CanNudgeSeek}"
                  ToolTip.Tip="Nudge the track: slide the waveform right (fine cueing)">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Classes="tick" VerticalAlignment="Center" Text="WAVE" />
              <TextBlock Text="►" />
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>

      <!-- EQ / filter knobs (pitch stays hardware/MIDI-only via DeckPitch — no on-screen knob) -->
      <UniformGrid Columns="4">
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <controls:Knob Width="53.8" Height="53.8" HorizontalAlignment="Center"
                         Value="{Binding EqHigh.Value}" IsEnabled="{Binding EqHigh.IsEnabled}" />
          <Grid ColumnDefinitions="*,*" Width="62">
            <TextBlock Classes="tick" Text="−∞" />
            <TextBlock Grid.Column="1" Classes="tick" HorizontalAlignment="Right" Text="+6" />
          </Grid>
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="HI" />
        </StackPanel>
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <controls:Knob Width="53.8" Height="53.8" HorizontalAlignment="Center"
                         Value="{Binding EqMid.Value}" IsEnabled="{Binding EqMid.IsEnabled}" />
          <Grid ColumnDefinitions="*,*" Width="62">
            <TextBlock Classes="tick" Text="−∞" />
            <TextBlock Grid.Column="1" Classes="tick" HorizontalAlignment="Right" Text="+6" />
          </Grid>
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="MID" />
        </StackPanel>
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <controls:Knob Width="53.8" Height="53.8" HorizontalAlignment="Center"
                         Value="{Binding EqLow.Value}" IsEnabled="{Binding EqLow.IsEnabled}" />
          <Grid ColumnDefinitions="*,*" Width="62">
            <TextBlock Classes="tick" Text="−∞" />
            <TextBlock Grid.Column="1" Classes="tick" HorizontalAlignment="Right" Text="+6" />
          </Grid>
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="LOW" />
        </StackPanel>
        <StackPanel Spacing="6" HorizontalAlignment="Center">
          <controls:Knob Width="53.8" Height="53.8" HorizontalAlignment="Center"
                         Value="{Binding Filter.Value}" IsEnabled="{Binding Filter.IsEnabled}" />
          <Grid ColumnDefinitions="*,*" Width="62">
            <TextBlock Classes="tick" Text="−∞" />
            <TextBlock Grid.Column="1" Classes="tick" HorizontalAlignment="Right" Text="+6" />
          </Grid>
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="FLT" />
        </StackPanel>
      </UniformGrid>
    </StackPanel>
  </Border>
</UserControl>
