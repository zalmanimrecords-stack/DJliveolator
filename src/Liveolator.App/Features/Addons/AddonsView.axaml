<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:addons="clr-namespace:Liveolator.App.Features.Addons"
             x:Class="Liveolator.App.Features.Addons.AddonsView"
             x:DataType="addons:AddonsViewModel">
  <Grid ColumnDefinitions="300,*" Margin="14">

    <!-- Add-on list -->
    <DockPanel Grid.Column="0" Margin="0,0,12,0">
      <TextBlock DockPanel.Dock="Top" Classes="section" Text="ADD-ONS" Margin="0,0,0,12" />
      <ListBox Classes="rows"
               ItemsSource="{Binding Addons}"
               SelectedItem="{Binding SelectedAddon, Mode=TwoWay}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="addons:AddonItemViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" />
                <TextBlock Classes="faint" Text="{Binding Description}" TextWrapping="Wrap" />
                <TextBlock Classes="faint mono" Text="{Binding State}" />
              </StackPanel>
              <Button Grid.Column="1" Classes="spartan" Content="Settings"
                      VerticalAlignment="Center" Margin="8,0,0,0"
                      IsVisible="{Binding HasSettings}"
                      Click="OnAddonSettingsClick" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Selected add-on settings -->
    <ScrollViewer Grid.Column="1">
      <StackPanel MaxWidth="1180" HorizontalAlignment="Left">

        <!-- VU meter: swap the dial-face background image. Sections flow into columns (WrapPanel) so the
             cards fill the width instead of a tall narrow ribbon with a dead right half. -->
        <StackPanel IsVisible="{Binding ShowVuMeterSettings}">
          <WrapPanel DataContext="{Binding VuMeterSettings}"
                     x:DataType="addons:VuMeterBackgroundSettingsViewModel">

           <StackPanel Classes="settings-group">
            <TextBlock Classes="section" Text="VU METER — NEEDLE ORIGIN" />
            <Border Classes="panel">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock Classes="faint" TextWrapping="Wrap"
                           Text="Where the needle pivots from. Bottom is the classic VU look (needle points up); Top hangs the needle down. The dial face follows your choice." />
                <ComboBox ItemsSource="{Binding Origins}"
                          SelectedItem="{Binding SelectedOrigin, Mode=TwoWay}"
                          HorizontalAlignment="Left" MinWidth="220" />
              </StackPanel>
            </Border>
           </StackPanel>

           <StackPanel Classes="settings-group">
            <TextBlock Classes="section" Text="VU METER — BACKGROUND IMAGE" />
            <Border Classes="panel">
              <StackPanel Spacing="12" Margin="10">
                <TextBlock Classes="faint" Text="Current face (background) image — the needle stays standard" />
                <SelectableTextBlock Classes="mono" Text="{Binding ImagePath}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="accent" Content="Choose image…" Click="OnBrowseFace" />
                  <Button Classes="spartan" Content="Reset to default"
                          Command="{Binding ResetToDefaultCommand}" IsEnabled="{Binding IsCustom}" />
                </StackPanel>
                <TextBlock Classes="faint" Foreground="{DynamicResource Amber}"
                           Text="{Binding AspectWarning}" TextWrapping="Wrap"
                           IsVisible="{Binding AspectWarning, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="faint" Text="{Binding Status}" />
              </StackPanel>
            </Border>
           </StackPanel>

           <StackPanel Classes="settings-group">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="section" Text="AI IMAGE PROMPT (BACKGROUND)"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="accent" Content="Copy prompt" Margin="10,0,0,0"
                      Tag="{Binding ImagePrompt}" Click="OnCopyText" />
            </Grid>
            <Border Classes="panel">
              <StackPanel Spacing="8" Margin="10">
                <TextBlock Classes="faint" TextWrapping="Wrap"
                           Text="Paste this into an AI image generator to create a matching background. The app draws the moving needle on top — the prompt tells the tool to leave it out and where the needle pivots." />
                <SelectableTextBlock Text="{Binding ImagePrompt}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
           </StackPanel>
          </WrapPanel>
        </StackPanel>

        <!-- Add-on with no configurable settings yet -->
        <StackPanel IsVisible="{Binding ShowNoSettingsMessage}">
          <TextBlock Classes="section" Text="SETTINGS" />
          <Border Classes="panel">
            <TextBlock Classes="faint" Margin="14" TextWrapping="Wrap"
                       Text="This add-on has no configurable settings yet." />
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
