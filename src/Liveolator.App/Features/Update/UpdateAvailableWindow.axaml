<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Liveolator.App.Features.Update.UpdateAvailableWindow"
        Width="440" SizeToContent="Height"
        MinWidth="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Update available">
  <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto">
    <TextBlock x:Name="TitleText" Grid.Row="0" Classes="section" Margin="0,0,0,12" />
    <TextBlock x:Name="MessageText" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,12" />
    <ItemsControl x:Name="NotesList" Grid.Row="2" Margin="0,0,0,20">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Classes="faint" Margin="0,0,0,4" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="LaterButton" Classes="spartan" Content="Later" Click="OnLater" />
      <Button x:Name="SkipButton" Classes="spartan" Content="Skip this version" Click="OnSkip" />
      <Button x:Name="DownloadButton" Classes="accent" Content="Download" Click="OnDownload" />
    </StackPanel>
  </Grid>
</Window>
