<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lib="clr-namespace:Liveolator.App.Features.Libraries"
             xmlns:shared="clr-namespace:Liveolator.App.Features.Shared"
             x:Class="Liveolator.App.Features.Libraries.LibrariesView"
             x:DataType="lib:LibrariesViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- sub-bar -->
    <Grid Row="0" ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,0,12">
      <Button Grid.Column="0" Classes="spartan" Content="Add folder"
              Click="OnAddFolder" Margin="0,0,8,0" />
      <Button Grid.Column="1" Classes="spartan" Content="Folders"
              Click="OnShowFolders" Margin="0,0,8,0" />
      <Button Grid.Column="2" Classes="spartan" Content="Playlists"
              Click="OnShowPlaylists" Margin="0,0,8,0" />
      <Button Grid.Column="3" Classes="accent" Content="Scan" Command="{Binding ScanCommand}" />
      <TextBox Grid.Column="4" Classes="spartan" Margin="12,0"
               Watermark="Search title or key…" Text="{Binding SearchText}" />
      <TextBlock Grid.Column="5" Classes="mono faint" VerticalAlignment="Center"
                 Text="{Binding ScanStatus}" />
    </Grid>

    <!-- main: table | detail -->
    <Grid Row="1" ColumnDefinitions="*,320">

      <!-- track table -->
      <Border Grid.Column="0" Classes="panel">
        <DockPanel Margin="12">
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Tracks" Margin="0,0,0,10" />
          <Grid DockPanel.Dock="Top" ColumnDefinitions="14,2.2*,1.4*,70,50,64,72" Margin="11,0,9,8">
            <TextBlock Grid.Column="1" Classes="faint" Text="TITLE" />
            <TextBlock Grid.Column="2" Classes="faint" Text="ARTIST" />
            <TextBlock Grid.Column="3" Classes="faint" Text="BPM" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Classes="faint" Text="KEY" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Classes="faint" Text="TIME" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Classes="faint" Text="STATUS" />
          </Grid>
          <ListBox Classes="rows"
                   ItemsSource="{Binding Tracks}"
                   SelectedItem="{Binding SelectedTrack}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="lib:TrackRowViewModel">
                <Grid ColumnDefinitions="14,2.2*,1.4*,70,50,64,72" VerticalAlignment="Center">
                  <Grid.ContextFlyout>
                    <MenuFlyout>
                      <MenuItem Header="Add to Deck A" Command="{Binding Menu.LoadToDeckACommand}" />
                      <MenuItem Header="Add to Deck B" Command="{Binding Menu.LoadToDeckBCommand}"
                                IsVisible="{Binding Menu.CanLoadToDeckB}" />
                      <Separator />
                      <MenuItem Header="Add to playlist" ItemsSource="{Binding Menu.AddToPlaylistItems}">
                        <MenuItem.ItemContainerTheme>
                          <ControlTheme TargetType="MenuItem" x:DataType="shared:MenuActionViewModel"
                                        BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding Header}" />
                            <Setter Property="Command" Value="{Binding Command}" />
                          </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                      </MenuItem>
                    </MenuFlyout>
                  </Grid.ContextFlyout>
                  <Ellipse Grid.Column="0" Width="6" Height="6" VerticalAlignment="Center"
                           Fill="{Binding Status, Converter={x:Static lib:StatusToBrushConverter.Instance}}" />
                  <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="2" Classes="muted" Text="{Binding Artist}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Classes="mono muted" Text="{Binding Bpm}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Classes="mono accent" Text="{Binding Key}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Classes="mono faint" Text="{Binding Duration}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Classes="faint" Text="{Binding StatusText}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- detail -->
      <Border Grid.Column="1" Classes="panel" Margin="16,0,0,0">
        <StackPanel Margin="16" Spacing="16">
          <TextBlock Classes="section" Text="Track" />

          <TextBlock Classes="faint"
                     Text="Select a track to see details."
                     IsVisible="{Binding SelectedTrack, Converter={x:Static ObjectConverters.IsNull}}" />

          <StackPanel Spacing="16"
                      IsVisible="{Binding SelectedTrack, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="2">
              <TextBlock FontSize="14" Text="{Binding SelectedTrack.Title}" TextWrapping="Wrap" />
              <TextBlock Classes="mono faint" Text="{Binding SelectedTrack.SubLine}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- live transport (Live Mode only) -->
            <StackPanel Spacing="8" IsVisible="{Binding IsLiveModeEnabled}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="accent" Content="▶ Play" Command="{Binding PlaySelectedCommand}" />
                <Button Classes="spartan" Content="■ Stop" Command="{Binding StopCommand}" />
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Classes="faint" VerticalAlignment="Center" Text="LIVE" />
                  <TextBlock Classes="mono accent" VerticalAlignment="Center" Text="{Binding LiveBpm}" />
                </StackPanel>
              </StackPanel>
              <!-- stage the track on a deck (load only, no auto-play) -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="spartan" Content="Load → A" Command="{Binding LoadToDeckACommand}" />
                <Button Classes="spartan" Content="Load → B" Command="{Binding LoadToDeckBCommand}"
                        IsVisible="{Binding CanLoadToDeckB}" />
              </StackPanel>
              <TextBlock Classes="mono faint" Text="{Binding LoadStatus}"
                         IsVisible="{Binding LoadStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <!-- analysis facts -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                <TextBlock Classes="faint" Text="TEMPO" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="mono accent" FontSize="14" Text="{Binding SelectedTrack.Bpm}" />
                  <TextBlock Classes="mono faint" VerticalAlignment="Bottom" Text="{Binding SelectedTrack.Confidence}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                <TextBlock Classes="faint" Text="KEY" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="mono accent" FontSize="14" Text="{Binding SelectedTrack.Key}" />
                  <TextBlock Classes="mono faint" VerticalAlignment="Bottom" Text="{Binding SelectedTrack.KeyName}" />
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2" Margin="0,14,0,0">
                <TextBlock Classes="faint" Text="LENGTH" />
                <TextBlock Classes="mono" FontSize="14" Text="{Binding SelectedTrack.Duration}" />
              </StackPanel>
            </Grid>

            <!-- file / tag info -->
            <StackPanel Spacing="8">
              <TextBlock Classes="faint" Text="INFO" />
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Album" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedTrack.Album}" TextTrimming="CharacterEllipsis" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Genre" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedTrack.Genre}" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Year" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding SelectedTrack.Year}" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Track #" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding SelectedTrack.TrackNo}" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Sample rate" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding SelectedTrack.SampleRate}" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Channels" />
                  <TextBlock Grid.Column="1" Classes="muted" Text="{Binding SelectedTrack.Channels}" />
                </Grid>
                <Grid ColumnDefinitions="96,*">
                  <TextBlock Grid.Column="0" Classes="faint" Text="Codec" />
                  <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding SelectedTrack.Codec}" />
                </Grid>
              </StackPanel>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Classes="faint" Text="HARMONIC MATCHES" />
              <ItemsControl ItemsSource="{Binding HarmonicMatches}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="lib:TrackRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                      <Grid.ContextFlyout>
                        <MenuFlyout>
                          <MenuItem Header="Add to Deck A" Command="{Binding Menu.LoadToDeckACommand}" />
                          <MenuItem Header="Add to Deck B" Command="{Binding Menu.LoadToDeckBCommand}"
                                    IsVisible="{Binding Menu.CanLoadToDeckB}" />
                          <Separator />
                          <MenuItem Header="Add to playlist" ItemsSource="{Binding Menu.AddToPlaylistItems}">
                            <MenuItem.ItemContainerTheme>
                              <ControlTheme TargetType="MenuItem" x:DataType="shared:MenuActionViewModel"
                                            BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Header}" />
                                <Setter Property="Command" Value="{Binding Command}" />
                              </ControlTheme>
                            </MenuItem.ItemContainerTheme>
                          </MenuItem>
                        </MenuFlyout>
                      </Grid.ContextFlyout>
                      <TextBlock Grid.Column="0" Classes="muted" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Classes="mono accent" Text="{Binding Key}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>

    </Grid>
  </Grid>
</UserControl>
