<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>liveolator-mcp</AssemblyName>
    <RootNamespace>Liveolator.Mcp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Liveolator.Core\Liveolator.Core.csproj" />
    <ProjectReference Include="..\Liveolator.Audio\Liveolator.Audio.csproj" />
    <ProjectReference Include="..\Liveolator.Media\Liveolator.Media.csproj" />
    <ProjectReference Include="..\Liveolator.Visuals\Liveolator.Visuals.csproj" />
    <ProjectReference Include="..\Liveolator.Online\Liveolator.Online.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <!-- render_set_preview mixes a set's transitions down through the offline renderer, which decodes and
       time-stretches through BASS/BASS_FX. Without these natives beside the server every warped clip
       fails to decode, so the server needs the same copy step the app does. -->
  <Import Project="..\Bass.Native.targets" />

</Project>
