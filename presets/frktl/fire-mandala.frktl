{
  "name": "FIRE MANDALA",
  "author": "Liveolator",
  "description": "Radial flame mandala with bass-driven breathing and ember glow.",
  "parameters": [
    { "id": "heat", "uniform": "uHeat", "label": "HEAT", "min": 0.0, "max": 2.0, "default": 1.1 },
    { "id": "spin", "uniform": "uSpin", "label": "SPIN", "min": 0.0, "max": 2.0, "default": 0.8 },
    { "id": "petals", "uniform": "uPetals", "label": "PETALS", "min": 0.0, "max": 1.0, "default": 0.6 },
    { "id": "embers", "uniform": "uEmbers", "label": "EMBERS", "min": 0.0, "max": 2.0, "default": 0.8 },
    { "id": "glow", "uniform": "uGlow", "label": "GLOW", "min": 0.0, "max": 2.0, "default": 1.0 }
  ],
  "shader": "#version 330 core\nin vec2 vTexCoord;\nout vec4 fragColor;\nuniform vec2 uResolution;\nuniform float uTime;\nuniform float uBeatFlash;\nuniform float uBeatPhase;\nuniform float uLevel;\nuniform float uBass;\nuniform float uHigh;\nuniform float uHeat;\nuniform float uSpin;\nuniform float uPetals;\nuniform float uEmbers;\nuniform float uGlow;\nfloat hash(vec2 p){ return fract(sin(dot(p,vec2(41.7,289.1)))*43758.5453); }\nvoid main(){\n  vec2 p=vTexCoord*2.0-1.0; p.x*=uResolution.x/max(uResolution.y,1.0);\n  float t=uTime*(0.15+uSpin*0.7);\n  float r=length(p);\n  float a=atan(p.y,p.x);\n  float petals=6.0+floor(uPetals*10.0);\n  float flame=sin(a*petals+t*2.0+r*7.0+uBass*2.0)*0.5+0.5;\n  flame*=smoothstep(1.15,0.05,r)*(0.6+0.5*sin(r*16.0-t*3.0));\n  float ring=exp(-abs(r-(0.34+uBass*0.08))*18.0)*(0.35+uBeatFlash*(1.0-uBeatPhase));\n  float ember=step(0.985-uHigh*0.01, hash(floor((p+2.0)*42.0)+floor(t*3.0))) * smoothstep(1.05,0.2,r) * uEmbers;\n  float e=(flame+ring+ember*0.45)*(0.35+uHeat*0.85)*(0.55+uLevel*0.8+uBeatFlash*0.35);\n  vec3 fire=mix(vec3(0.45,0.02,0.0),vec3(1.0,0.75,0.12),clamp(e,0.0,1.0));\n  vec3 col=vec3(0.006,0.002,0.001)+fire*e*(0.6+uGlow*0.45);\n  col=col/(1.0+col*0.55);\n  fragColor=vec4(col,1.0);\n}\n"
}
