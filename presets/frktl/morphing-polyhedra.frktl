{
  "name": "MORPHING POLYHEDRA",
  "author": "Liveolator",
  "description": "Fake-3D crystalline shapes that rotate, fold, and pulse with the beat.",
  "parameters": [
    { "id": "depth", "uniform": "uDepth", "label": "DEPTH", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "id": "speed", "uniform": "uSpeed", "label": "SPEED", "min": 0.0, "max": 2.5, "default": 0.8 },
    { "id": "morph", "uniform": "uMorph", "label": "MORPH", "min": 0.0, "max": 1.0, "default": 0.55 },
    { "id": "edges", "uniform": "uEdges", "label": "EDGES", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "id": "glow", "uniform": "uGlow", "label": "GLOW", "min": 0.0, "max": 2.0, "default": 0.9 }
  ],
  "shader": "#version 330 core\nin vec2 vTexCoord;\nout vec4 fragColor;\nuniform vec2 uResolution;\nuniform float uTime;\nuniform float uBeatFlash;\nuniform float uBarPhase;\nuniform float uLevel;\nuniform float uBass;\nuniform float uMid;\nuniform float uDepth;\nuniform float uSpeed;\nuniform float uMorph;\nuniform float uEdges;\nuniform float uGlow;\nmat2 rot(float a){ float c=cos(a),s=sin(a); return mat2(c,-s,s,c); }\nfloat poly(vec2 p, float n){ float a=atan(p.y,p.x)+3.14159265; float r=6.2831853/n; return cos(floor(0.5+a/r)*r-a)*length(p); }\nvoid main(){\n  vec2 p=vTexCoord*2.0-1.0; p.x*=uResolution.x/max(uResolution.y,1.0);\n  float t=uTime*(0.2+uSpeed*0.9);\n  p*=rot(t*0.35+uBarPhase*0.3);\n  float z=0.0; vec3 col=vec3(0.005,0.006,0.018);\n  for(int i=0;i<7;i++){\n    float fi=float(i);\n    vec2 q=p*(1.0+fi*0.18+uDepth*0.12);\n    q*=rot(t*(0.22+fi*0.05)+fi);\n    float sides=mix(3.0,8.0,fract(uMorph+fi*0.17+0.2*sin(t)));\n    float d=abs(poly(q, sides)-(0.28+fi*0.045+uBass*0.03));\n    float edge=exp(-d*d/(0.00045/(0.4+uEdges)));\n    vec3 pal=0.5+0.5*cos(6.28318*(vec3(0.02,0.38,0.72)+fi*0.09+t*0.025+uMid*0.15));\n    col+=pal*edge*(0.18+uGlow*0.25+uLevel*0.2);\n    z+=edge;\n  }\n  float core=exp(-dot(p,p)*(2.4-uDepth*0.5))*(0.04+uBeatFlash*0.18);\n  col+=vec3(0.7,0.9,1.0)*core;\n  col+=pow(max(z,0.0),2.0)*vec3(0.06,0.11,0.20);\n  col=col/(1.0+col*0.55);\n  fragColor=vec4(col,1.0);\n}\n"
}
