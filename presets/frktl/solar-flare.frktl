{
  "name": "SOLAR FLARE",
  "author": "Liveolator",
  "description": "Explosive sun corona with plasma arcs and downbeat bursts.",
  "parameters": [
    { "id": "flare", "uniform": "uFlare", "label": "FLARE", "min": 0.0, "max": 2.0, "default": 1.1 },
    { "id": "speed", "uniform": "uSpeed", "label": "SPEED", "min": 0.0, "max": 2.5, "default": 0.8 },
    { "id": "rays", "uniform": "uRays", "label": "RAYS", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "id": "heat", "uniform": "uHeat", "label": "HEAT", "min": 0.0, "max": 2.0, "default": 1.0 },
    { "id": "core", "uniform": "uCore", "label": "CORE", "min": 0.0, "max": 1.0, "default": 0.55 }
  ],
  "shader": "#version 330 core\nin vec2 vTexCoord;\nout vec4 fragColor;\nuniform vec2 uResolution;\nuniform float uTime;\nuniform float uBeatFlash;\nuniform float uLevel;\nuniform float uBass;\nuniform float uLowMid;\nuniform float uFlare;\nuniform float uSpeed;\nuniform float uRays;\nuniform float uHeat;\nuniform float uCore;\nvoid main(){\n  vec2 p=vTexCoord*2.0-1.0; p.x*=uResolution.x/max(uResolution.y,1.0);\n  float t=uTime*(0.12+uSpeed*0.55);\n  float r=length(p);\n  float a=atan(p.y,p.x);\n  float corona=exp(-r*(2.8-uCore))*0.35;\n  float rays=pow(max(0.0, sin(a*(9.0+uRays*12.0)+t*3.0)+0.3*sin(a*27.0-t*2.0)),2.0)*smoothstep(1.2,0.1,r)*uRays;\n  float core=exp(-r*r*(8.0-uCore*4.5))*(0.7+uBass*0.5+uBeatFlash*0.6);\n  float flare=exp(-abs(r-(0.38+uLowMid*0.08))*9.0)*(0.25+uBeatFlash*0.9)*uFlare;\n  float e=(corona+rays*0.16+core+flare)*(0.65+uLevel*0.7)*(0.5+uHeat*0.7);\n  vec3 col=mix(vec3(0.25,0.02,0.0),vec3(1.0,0.86,0.22),clamp(e,0.0,1.0))*e;\n  col+=vec3(1.0,0.22,0.03)*rays*0.08;\n  col=col/(1.0+col*0.58);\n  fragColor=vec4(col,1.0);\n}\n"
}
