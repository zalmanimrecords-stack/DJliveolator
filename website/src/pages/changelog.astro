---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import changelog from "../data/changelog.json";
---

<Base
  title={`Changelog — ${site.name}`}
  description={`Release notes for ${site.name}, newest first.`}
>
  <Nav />
  <main class="page">
    <header class="page-head container reveal">
      <p class="eyebrow">Changelog</p>
      <h1>What's new</h1>
      <p>
        Every {site.name} build, newest first. It's {site.stage.toLowerCase()} —
        things move fast and occasionally break. Spotted something off?
        <a href="/#feedback">Tell us</a>.
      </p>
    </header>

    <section class="container log">
      {
        changelog.map((rel, i) => (
          <article class="rel reveal">
            <div class="rel-meta">
              <span class="rel-ver">v{rel.version}</span>
              {i === 0 && <span class="rel-current">current</span>}
              <time class="rel-date">{rel.date}</time>
            </div>
            <ul class="rel-notes">
              {rel.notes.map((n) => (
                <li>{n}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="container page-cta reveal">
      <a class="btn btn-primary" href="/#download">Download v{site.version}</a>
      <a class="btn btn-ghost" href="/manual">Read the manual</a>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-top: 40px; }
  .page-head { max-width: 720px; padding-top: 36px; padding-bottom: 8px; }
  .page-head h1 { font-size: clamp(34px, 5vw, 52px); }
  .page-head p { margin-top: 16px; color: var(--text-dim); font-size: 18px; }

  .log {
    margin-top: 40px;
    display: grid;
    gap: 14px;
    max-width: 820px;
  }
  .rel {
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px 26px;
  }
  .rel-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .rel-ver {
    font-family: var(--font-mono);
    font-size: 17px;
    font-weight: 700;
    color: var(--amber);
  }
  .rel-current {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #1a1206;
    background: var(--amber);
    border-radius: 999px;
    padding: 3px 9px;
  }
  .rel-date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-mute);
    margin-left: auto;
  }
  .rel-notes {
    margin: 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
  }
  .rel-notes li {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.55;
  }
  .rel-notes li::marker { color: var(--amber-dim); }

  .page-cta {
    margin-top: 48px;
    padding-bottom: 20px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    max-width: 820px;
  }
</style>
