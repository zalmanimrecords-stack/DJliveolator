---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { manual } from "../data/manual";
---

<Base
  title={`Manual — ${site.name}`}
  description={`How to use ${site.name}: install, controllers, decks, libraries, visuals and more.`}
>
  <Nav />
  <main class="page">
    <header class="page-head container reveal">
      <p class="eyebrow">User manual</p>
      <h1>Using {site.name}</h1>
      <p>
        A practical guide to the app as it stands today. It's {site.stage.toLowerCase()},
        so this grows and changes with each build.
      </p>
      <p class="updated">Last updated {site.manualUpdated} · covers v{site.version}</p>
    </header>

    <div class="container manual-grid">
      <aside class="toc" aria-label="Manual contents">
        <nav>
          <p class="toc-title">Contents</p>
          <ol>
            {manual.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
          </ol>
        </nav>
      </aside>

      <div class="manual-body">
        {
          manual.map((s) => (
            <section id={s.id} class="m-section reveal">
              <h2>{s.title}</h2>
              {s.blocks.map((b) =>
                b.kind === "p" ? (
                  <p>{b.text}</p>
                ) : b.kind === "list" ? (
                  <ul>{b.items.map((i) => <li>{i}</li>)}</ul>
                ) : (
                  <ol class="steps">{b.items.map((i) => <li>{i}</li>)}</ol>
                )
              )}
            </section>
          ))
        }

        <section class="page-cta reveal">
          <a class="btn btn-primary" href="/#download">Download {site.name}</a>
          <a class="btn btn-ghost" href="/#feedback">Ask a question</a>
        </section>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .page { padding-top: 40px; }
  .page-head { max-width: 760px; padding-top: 36px; }
  .page-head h1 { font-size: clamp(34px, 5vw, 52px); }
  .page-head p { margin-top: 16px; color: var(--text-dim); font-size: 18px; }
  .updated {
    font-family: var(--font-mono);
    font-size: 13px !important;
    color: var(--text-mute) !important;
    margin-top: 12px !important;
  }

  .manual-grid {
    margin-top: 40px;
    padding-bottom: 24px;
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .toc {
    position: sticky;
    top: 84px;
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-mute);
    margin-bottom: 12px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
    border-left: 1px solid var(--border);
  }
  .toc a {
    display: block;
    padding-left: 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-dim);
    font-size: 14.5px;
    line-height: 1.4;
  }
  .toc a:hover {
    color: var(--amber-bright);
    border-left-color: var(--amber);
  }

  .manual-body { max-width: 720px; }
  .m-section { scroll-margin-top: 84px; margin-bottom: 44px; }
  .m-section h2 {
    font-size: 24px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .m-section p {
    color: var(--text-dim);
    font-size: 16.5px;
    line-height: 1.7;
    margin-bottom: 14px;
  }
  .m-section ul,
  .m-section ol {
    margin: 0 0 16px;
    padding-left: 22px;
    display: grid;
    gap: 9px;
  }
  .m-section li {
    color: var(--text-dim);
    font-size: 16px;
    line-height: 1.6;
  }
  .m-section li::marker { color: var(--amber-dim); }
  .steps li { padding-left: 4px; }

  .page-cta {
    margin-top: 8px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 820px) {
    .manual-grid { grid-template-columns: 1fr; gap: 24px; }
    .toc {
      position: static;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 20px;
      background: var(--bg-elev);
    }
  }
</style>
