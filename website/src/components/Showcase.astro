---
import { shots, site } from "../data/site";
---

<section class="section" id="showcase">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">Inside the app</p>
      <h2>Six tabs, one performance</h2>
      <p>
        LIVE, DJ, STUDIO, VJ, LIBRARIES and SETTINGS — the whole rig in a single
        dark, focused window built for the booth.
      </p>
    </div>

    <div class="showcase reveal" data-showcase>
      <div class="tabs" role="tablist" aria-label="App screens">
        {
          shots.map((s, i) => (
            <button
              class:list={["tab", { active: i === 0 }]}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
              data-tab={i}
            >
              {s.label}
            </button>
          ))
        }
      </div>

      <div class="stage">
        {
          shots.map((s, i) => (
            <figure class:list={["frame", { active: i === 0 }]} data-frame={i}>
              <img
                src={`${s.src}?v=${site.version}`}
                alt={s.alt}
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{s.caption}</figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .showcase {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, var(--bg-elev), var(--bg-elev-2));
    overflow: hidden;
  }
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.25);
  }
  .tab {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 8px 15px;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .tab:hover { color: var(--amber-bright); }
  .tab.active {
    color: var(--amber-bright);
    border-color: var(--border-strong);
    background: rgba(232, 163, 61, 0.08);
  }

  .stage {
    position: relative;
    padding: 22px;
  }
  .frame {
    margin: 0;
    display: none;
  }
  .frame.active { display: block; }
  .frame img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
  }
  .frame figcaption {
    margin-top: 16px;
    color: var(--text-dim);
    font-size: 15.5px;
    text-align: center;
  }

  @media (max-width: 600px) {
    .stage { padding: 14px; }
  }
</style>

<script>
  // Tabbed screenshot switcher. Without JS the first frame stays visible.
  for (const root of document.querySelectorAll<HTMLElement>("[data-showcase]")) {
    const tabs = root.querySelectorAll<HTMLButtonElement>(".tab");
    const frames = root.querySelectorAll<HTMLElement>(".frame");

    const select = (idx: number) => {
      tabs.forEach((t, i) => {
        const on = i === idx;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      frames.forEach((f, i) => f.classList.toggle("active", i === idx));
    };

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        select(Number(tab.dataset.tab));
      });
    });
  }
</script>
