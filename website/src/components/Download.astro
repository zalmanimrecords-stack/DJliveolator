---
import { site } from "../data/site";
---

<section class="section download" id="download">
  <div class="container">
    <div class="dl-inner reveal">
      <p class="eyebrow">Get Liveolator</p>
      <h2>Download the free build</h2>
      <p class="dl-note">
        <strong>Alpha, for Windows</strong> — expect bugs. Grab the
        installer below and you're mixing in minutes; it works with any MIDI
        controller you plug in.
      </p>

      <form class="dl-gate" id="dl-gate" novalidate>
        <div class="dl-gate-row">
          <input
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            aria-label="Your email address"
          />
          <button class="btn btn-primary" type="submit">Email me the download</button>
        </div>
        <label class="dl-optin">
          <input type="checkbox" name="newsletter_opt_in" value="1" />
          <span>
            Keep me in the loop — join the Zalmanim mailing list for updates on
            software, plugins, new music and everything new at Zalmanim. (Optional.)
          </span>
        </label>
        <!-- Honeypot: hidden from people, tempting to bots. Leave empty. -->
        <input
          type="text"
          name="company"
          class="dl-hp"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
        />
        <p class="dl-gate-msg" role="status" aria-live="polite" hidden></p>
        <p class="dl-gate-fine">
          We email you a secure download link that works for 24 hours. We don't
          share your address.
        </p>
      </form>

      <p class="dl-build">
        Windows installer · {site.stage} v{site.version} · {site.downloadSize} · .exe
        · <a href="/changelog">what's new & older versions</a>
      </p>

      <p class="dl-fine">
        New to it? Read the <a href="/manual">manual</a>. Prefer to follow along?
        The project lives on
        <a href={site.repoUrl} target="_blank" rel="noopener">GitHub</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .download {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(700px 280px at 50% 0, rgba(232, 163, 61, 0.1), transparent 65%),
      var(--bg-elev);
  }
  .dl-inner {
    text-align: center;
    max-width: 620px;
    margin: 0 auto;
  }
  .download .eyebrow { margin-bottom: 14px; }
  .download h2 { font-size: clamp(28px, 4.6vw, 44px); }
  .dl-note {
    margin: 18px auto 0;
    color: var(--text-dim);
    font-size: 18px;
    max-width: 520px;
  }
  .dl-note strong {
    color: var(--amber);
    font-weight: 700;
  }
  .dl-build {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    color: var(--text-mute);
  }
  .dl-fine {
    margin-top: 20px;
    color: var(--text-mute);
    font-size: 14.5px;
  }

  .dl-gate {
    margin: 32px auto 0;
    max-width: 480px;
    text-align: left;
  }
  .dl-gate-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .dl-gate input[type="email"] {
    flex: 1 1 220px;
    min-width: 0;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: var(--bg-elev);
    color: inherit;
    font-size: 16px;
  }
  .dl-gate-row .btn {
    flex: 0 0 auto;
  }
  .dl-optin {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    margin-top: 14px;
    color: var(--text-dim);
    font-size: 14px;
    line-height: 1.5;
  }
  .dl-optin input {
    margin-top: 3px;
    flex: 0 0 auto;
  }
  /* Honeypot stays in the DOM for bots but never shown to people. */
  .dl-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .dl-gate-msg {
    margin-top: 14px;
    padding: 10px 12px;
    border-radius: 8px;
    font-size: 14.5px;
  }
  .dl-gate-msg.is-ok {
    background: rgba(46, 160, 67, 0.12);
    color: #4ac26b;
  }
  .dl-gate-msg.is-err {
    background: rgba(248, 81, 73, 0.12);
    color: #ff7b72;
  }
  .dl-gate-fine {
    margin-top: 14px;
    color: var(--text-mute);
    font-size: 13px;
  }
</style>

<script define:vars={{ apiUrl: site.downloadApiUrl, product: site.productSlug }}>
  // Email-gated download: POST the address to the WP backend, which emails a
  // signed 24h link. Sent as form-urlencoded so the browser skips a CORS
  // preflight; the backend returns an Access-Control-Allow-Origin for this site.
  const form = document.getElementById("dl-gate");
  if (form) {
    const msg = form.querySelector(".dl-gate-msg");
    const button = form.querySelector('button[type="submit"]');

    const show = (text, ok) => {
      msg.textContent = text;
      msg.className = "dl-gate-msg " + (ok ? "is-ok" : "is-err");
      msg.hidden = false;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = form.email.value.trim();
      if (!email || !email.includes("@")) {
        show("Please enter a valid email address.", false);
        form.email.focus();
        return;
      }

      const body = new URLSearchParams();
      body.set("email", email);
      body.set("product", product);
      body.set("newsletter_opt_in", form.newsletter_opt_in.checked ? "1" : "0");
      body.set("company", form.company.value);

      button.disabled = true;
      msg.hidden = true;
      try {
        const res = await fetch(apiUrl, {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: body.toString(),
        });
        const data = await res.json().catch(() => ({ success: false }));
        if (res.ok && data.success) {
          show(data.message || "Check your email for your download link.", true);
          form.reset();
        } else {
          show(data.message || "Something went wrong. Please try again.", false);
        }
      } catch (err) {
        show("Could not reach the server. Please try again in a moment.", false);
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
