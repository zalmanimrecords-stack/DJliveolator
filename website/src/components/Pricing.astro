---
import { site } from "../data/site";

const perks = [
  "Both engines — DJ and VJ — fully unlocked",
  "Use it for real gigs, no watermark, no time limit",
  "Open source under the GPLv3 — audit it, fork it, keep it",
  "Every update, free — forever",
  "Your feedback shapes what gets built next",
];
---

<section class="section" id="pricing">
  <div class="container">
    <div class="price-card card reveal">
      <div class="price-left">
        <p class="eyebrow">Pricing</p>
        <h2>Free forever — and open source</h2>
        <p class="price-note">
          Liveolator is completely free, and it always will be — no account, no
          trial countdown, no locked features. It's also
          <strong>open source under the GPLv3</strong>: the full source is on
          GitHub for anyone to read, audit or fork. The goal is simple — get it
          into the hands of DJs and VJs and build the rest with their feedback.
        </p>
        <div class="price-actions">
          <a class="btn btn-primary" href="#download">Download for Windows</a>
          <a class="btn btn-ghost" href={site.repoUrl} target="_blank" rel="noopener">
            View source on GitHub
          </a>
        </div>
      </div>

      <div class="price-right">
        <div class="price-tag">
          <span class="amount">$0</span>
          <span class="period">forever</span>
        </div>
        <ul class="perks">
          {perks.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .price-card {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    padding: 48px;
    position: relative;
    overflow: hidden;
  }
  .price-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(600px 300px at 100% 0, var(--amber-glow), transparent 60%);
    opacity: 0.5;
    pointer-events: none;
  }
  .price-left, .price-right { position: relative; z-index: 1; }

  .price-card h2 { font-size: clamp(28px, 4vw, 38px); }
  .price-note {
    margin-top: 18px;
    color: var(--text-dim);
    font-size: 17px;
    max-width: 460px;
  }
  .price-note strong { color: var(--amber); font-weight: 700; }
  .price-actions {
    margin-top: 30px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .price-right {
    border-left: 1px solid var(--border);
    padding-left: 48px;
  }
  .price-tag {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .amount {
    font-size: 58px;
    font-weight: 800;
    color: var(--amber);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .perks {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 13px;
  }
  .perks li {
    position: relative;
    padding-left: 26px;
    color: var(--text-dim);
    font-size: 15.5px;
    line-height: 1.5;
  }
  .perks li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--amber);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .price-card {
      grid-template-columns: 1fr;
      gap: 34px;
      padding: 34px 26px;
    }
    .price-right {
      border-left: 0;
      border-top: 1px solid var(--border);
      padding-left: 0;
      padding-top: 30px;
    }
  }
</style>
