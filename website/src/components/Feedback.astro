---
import { site } from "../data/site";
---

<section class="section" id="feedback">
  <div class="container">
    <div class="fb-grid">
      <div class="fb-intro reveal">
        <p class="eyebrow">Your turn</p>
        <h2>Questions and ideas welcome</h2>
        <p>
          Liveolator is being built for the people who actually use it. If
          something's missing, awkward, or could be faster — tell me. Every
          inquiry and efficiency suggestion goes straight to the developer and
          helps decide what gets built next.
        </p>
        <p class="fb-direct">
          Prefer email?
          <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
        </p>
      </div>

      <form class="fb-form card reveal" data-feedback aria-label="Send feedback">
        <div class="field">
          <label for="fb-name">Name</label>
          <input id="fb-name" name="name" type="text" autocomplete="name" placeholder="Your name" />
        </div>

        <div class="field">
          <label for="fb-email">Email <span class="opt">(so I can reply)</span></label>
          <input id="fb-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
        </div>

        <div class="field">
          <label for="fb-type">Type</label>
          <select id="fb-type" name="type">
            <option value="Feature suggestion">Feature suggestion</option>
            <option value="Efficiency / workflow idea">Efficiency / workflow idea</option>
            <option value="Question">Question</option>
            <option value="Bug report">Bug report</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="field">
          <label for="fb-message">Message <span class="req">*</span></label>
          <textarea
            id="fb-message"
            name="message"
            rows="5"
            required
            placeholder="What would make Liveolator better for you?"></textarea>
        </div>

        <button class="btn btn-primary fb-submit" type="submit">Send via email</button>
        <p class="fb-hint" data-hint aria-live="polite">
          Opens your email app with the message ready to send.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .fb-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 48px;
    align-items: start;
  }
  .fb-intro h2 { font-size: clamp(28px, 4vw, 40px); margin-top: 10px; }
  .fb-intro p {
    margin-top: 18px;
    color: var(--text-dim);
    font-size: 17px;
  }
  .fb-direct { font-family: var(--font-mono); font-size: 14.5px; }

  .fb-form {
    padding: 30px;
    display: grid;
    gap: 18px;
  }
  .field { display: grid; gap: 7px; }
  label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .opt { text-transform: none; color: var(--text-mute); letter-spacing: 0; }
  .req { color: var(--amber); }

  input, select, textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 16px;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  textarea { resize: vertical; min-height: 120px; }
  input::placeholder, textarea::placeholder { color: var(--text-mute); }
  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--amber);
    box-shadow: 0 0 0 3px rgba(232, 163, 61, 0.16);
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--amber) 50%),
      linear-gradient(135deg, var(--amber) 50%, transparent 50%);
    background-position: calc(100% - 18px) center, calc(100% - 13px) center;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 36px;
  }

  .fb-submit { justify-content: center; margin-top: 4px; }
  .fb-hint {
    font-size: 13.5px;
    color: var(--text-mute);
    text-align: center;
  }
  .fb-hint.error { color: var(--amber-bright); }

  @media (max-width: 820px) {
    .fb-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>

<script define:vars={{ contactEmail: site.contactEmail, appName: site.name }}>
  // Build a mailto: link from the form and hand off to the user's email app.
  // No server, no third party — works on a fully static host.
  for (const form of document.querySelectorAll("[data-feedback]")) {
    const hint = form.querySelector("[data-hint]");

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const data = new FormData(form);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const type = String(data.get("type") || "Feedback").trim();
      const message = String(data.get("message") || "").trim();

      if (!message) {
        if (hint) {
          hint.textContent = "Please add a short message before sending.";
          hint.classList.add("error");
        }
        form.querySelector("#fb-message")?.focus();
        return;
      }

      const subject = `[${appName}] ${type}`;
      const body = [
        message,
        "",
        "—",
        name ? `From: ${name}` : null,
        email ? `Reply to: ${email}` : null,
      ]
        .filter((line) => line !== null)
        .join("\n");

      const href =
        `mailto:${contactEmail}` +
        `?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(body)}`;

      if (hint) {
        hint.textContent = "Opening your email app…";
        hint.classList.remove("error");
      }
      window.location.href = href;
    });
  }
</script>
