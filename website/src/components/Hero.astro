---
import { site } from "../data/site";
---

<section class="hero" id="top">
  <div class="container hero-inner">
    <div class="hero-copy">
      <span class="pill"><span class="dot"></span> {site.stage} · free forever &amp; open source</span>

      <h1>
        Mix the music.<br />
        Move the visuals.<br />
        <span class="accent">One beat.</span>
      </h1>

      <p class="lede">
        {site.name} is a cross-platform DJ + VJ performance app. The visuals are
        locked to the music on a single shared beat clock — so every cut, effect
        and transition lands on the beat, automatically.
      </p>

      <p class="alpha-note">
        <strong>Heads up:</strong> this is an early <strong>alpha</strong> — it's
        rough and there are plenty of bugs. It's free, and always will be, so your
        <a href="#feedback">bug reports and ideas</a> matter so much.
      </p>

      <div class="hero-actions">
        <a class="btn btn-primary" href="#download">Download for Windows</a>
        <a class="btn btn-ghost" href={site.repoUrl} target="_blank" rel="noopener">View source on GitHub</a>
      </div>

      <ul class="hero-meta">
        <li>Windows</li>
        <li>Any MIDI controller</li>
        <li>DJ + VJ in one app</li>
      </ul>
    </div>

    <figure class="hero-shot reveal">
      <img
        src={`/screenshots/live.png?v=${site.version}-${site.shotRev}`}
        alt="Liveolator LIVE view — dual waveforms, two decks, mixer and a visuals strip"
        width="1440"
        height="900"
        loading="eager"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: 72px 0 56px;
    position: relative;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: center;
  }
  .hero h1 {
    font-size: clamp(38px, 6.4vw, 66px);
    margin: 22px 0 0;
  }
  .accent {
    color: var(--amber);
    text-shadow: 0 0 38px var(--amber-glow);
  }
  .lede {
    margin-top: 26px;
    max-width: 520px;
    color: var(--text-dim);
    font-size: 19px;
  }
  .alpha-note {
    margin-top: 20px;
    max-width: 520px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-dim);
    border-left: 2px solid var(--amber);
    padding: 2px 0 2px 14px;
  }
  .alpha-note strong { color: var(--amber); font-weight: 700; }
  .hero-actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-meta {
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-mute);
  }
  .hero-meta li {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .hero-meta li::before {
    content: "";
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--amber);
  }

  .hero-shot {
    margin: 0;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    overflow: hidden;
    background: var(--bg-elev);
    box-shadow:
      0 30px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(0, 0, 0, 0.4),
      0 0 70px -30px var(--amber-glow);
  }
  .hero-shot img { width: 100%; height: auto; }

  @media (max-width: 940px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .lede { max-width: none; }
  }
</style>
