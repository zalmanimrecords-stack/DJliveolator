# Rendered at container start by the nginx image's envsubst step
# (/etc/nginx/templates/*.template -> /etc/nginx/conf.d/). Only
# ${DOWNLOAD_LINK_SECRET} is substituted (NGINX_ENVSUBST_FILTER in
# docker-compose.yml), so nginx runtime variables like $uri are left intact.
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Privacy / security headers for page responses. interest-cohort=() opts the
    # site out of FLoC/Topics-style cohort tracking.
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()" always;

    # Compress text assets on the fly.
    gzip on;
    gzip_vary on;
    gzip_min_length 256;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml;

    # Astro emits content-hashed assets here — safe to cache forever.
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Screenshots and other static media: cache for a week.
    location /screenshots/ {
        expires 7d;
        add_header Cache-Control "public";
    }

    # Gated installer downloads. The link is signed by the WordPress backend
    # (zalmanim.com) with a shared secret and a 24-hour expiry baked in; nginx
    # verifies it here with the built-in secure_link module. A request with no
    # signature, a wrong signature, or a past expiry gets 403/410 — so the email
    # gate cannot be bypassed by guessing the file URL.
    location /downloads/ {
        secure_link $arg_md5,$arg_expires;
        secure_link_md5 "$secure_link_expires$uri ${DOWNLOAD_LINK_SECRET}";

        # Empty result = bad/missing signature; "0" = signature ok but expired.
        if ($secure_link = "") { return 403; }
        if ($secure_link = "0") { return 410; }

        add_header Content-Disposition "attachment";
        add_header Cache-Control "no-store" always;
    }

    # Single-page static site: fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Don't leak the nginx version.
    server_tokens off;
}
